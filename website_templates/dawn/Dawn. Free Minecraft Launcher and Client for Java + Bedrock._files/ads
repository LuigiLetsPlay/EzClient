    <style>
        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            height: 100%;
        }

        #adContent {
            position: relative;
            z-index: 2;
            width: 100%;
            height: 100%;
            padding: clamp(4px, 5%, 20px);
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: clamp(3px, 4%, 14px);
        }

        #title {
            font-size: clamp(13px, 9vw, 32px);
            font-weight: bold;
            color: #ffffff;
            line-height: 1.05;
            white-space: nowrap;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            animation: fadeInUp 1s ease-out;
        }

        #subText {
            color: #e8f0ff;
            font-size: clamp(10px, 3.5vw, 14px);
            font-weight: 300;
            line-height: 1.15;
            opacity: 0.9;
            animation: fadeInUp 1s ease-out 0.2s both;
        }

        #heading {
            color: #ffffff;
            font-size: clamp(11px, 4.5vw, 18px);
            font-weight: 600;
            line-height: 1.15;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
            animation: fadeInUp 1s ease-out 0.4s both;
        }

        #cta {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #ffffff;
            padding: clamp(4px, 2.5%, 12px) clamp(10px, 6%, 24px);
            border-radius: 25px;
            font-size: clamp(10px, 3.5vw, 14px);
            font-weight: 500;
            white-space: nowrap;
            display: inline-block;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            animation: fadeInUp 1s ease-out 0.6s both;
        }

        /* Smallest sizes (e.g. 120x125, 125x125, 180x150, 234x60, 300x50, 320x50): show only title + button. */
        #subText,
        #heading {
            display: none;
        }

        /* Enough height for a secondary line (e.g. 200x200, 120x240, skyscrapers). */
        @media (min-height: 175px) {
            #heading {
                display: block;
            }
        }

        /* Tall slots (e.g. 120x240, 120x600, 160x600): show the full message. */
        @media (min-height: 230px) {
            #subText {
                display: block;
            }
        }

        /* Short/wide banners (e.g. 234x60, 300x50, 320x50): lay title and button out side by side. */
        @media (max-height: 110px) {
            #adContent {
                flex-direction: row;
                justify-content: space-between;
                gap: clamp(6px, 3%, 12px);
                padding: clamp(4px, 4%, 8px) clamp(8px, 5%, 14px);
            }
            #subText,
            #heading {
                display: none;
            }
            #title {
                font-size: clamp(16px, 6vw, 24px);
            }
            #cta {
                flex-shrink: 0;
                padding: clamp(5px, 12%, 8px) clamp(10px, 5%, 16px);
                font-size: clamp(12px, 4vw, 15px);
            }
        }

        /* Very short banners (e.g. 300x50, 320x50): keep the title from dominating the 50px height. */
        @media (max-height: 70px) {
            #title {
                font-size: clamp(14px, 4.5vw, 18px);
            }
        }

        /* Short but wide banners (e.g. 300x50, 320x50): use the middle gap for the heading. */
        @media (max-height: 110px) and (min-width: 300px) {
            #heading {
                display: block;
                white-space: nowrap;
                font-size: clamp(13px, 4vw, 16px);
            }
        }
