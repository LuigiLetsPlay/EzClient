        @keyframes sp-fade {
          from { opacity: 0; }
        }
        @keyframes sp-pop {
          from { opacity: 0; transform: translateY(24px) scale(0.96); }
        }
        @keyframes sp-rise {
          from { opacity: 0; transform: translateY(14px); }
        }
        @keyframes sp-float {
          0%, 100% { transform: translateY(0) rotate(0deg); }
          50% { transform: translateY(-16px) rotate(12deg); }
        }
        @keyframes sp-wiggle {
          0%, 100% { transform: rotate(0deg); }
          25% { transform: rotate(-8deg); }
          75% { transform: rotate(8deg); }
        }
        .sp-backdrop { animation: sp-fade 0.3s ease-out both; }
        .sp-card { animation: sp-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
        .sp-heads { animation: sp-fade 0.4s ease-out both; }
        .sp-pixel { animation-name: sp-float; animation-timing-function: ease-in-out; animation-iteration-count: infinite; }
        .sp-channel {
          animation: sp-rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
          transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s, background-color 0.2s;
        }
        .sp-channel:hover {
          border-color: var(--sp-brand);
          box-shadow: 0 8px 32px -8px var(--sp-glow);
          background-color: rgba(255, 255, 255, 0.06);
          transform: translateY(-2px);
        }
        .sp-channel:hover .sp-tile svg { animation: sp-wiggle 0.4s ease-in-out; }
        .sp-cta { transition: filter 0.2s, box-shadow 0.2s; }
        .sp-channel:hover .sp-cta {
          filter: brightness(1.12);
          box-shadow: 0 4px 18px -4px var(--sp-glow);
        }
        @media (prefers-reduced-motion: reduce) {
          .sp-backdrop, .sp-card, .sp-channel, .sp-heads { animation: none; }
          .sp-channel:hover { transform: none; }
          .sp-channel:hover .sp-tile svg { animation: none; }
        }
