 as Server Owner","remove_owner":"Remove Server Owner","permission_view_only":"View Only","permission_giveaway_manager":"Giveaway Manager","permission_manager":"Manager","permission_owner":"Owner","cloak_submission":"Cloak Submission #%id%","cloak_submitted":"Submitted %date%","cloak_pending_review":"Pending Review","discord_title":"Partner Discord","discord_description":"Join the exclusive partner Discord server to connect with other partners and the LabyMod team.","discord_join":"Join Discord","discord_joining":"Joining...","discord_join_success":"Successfully joined the partner Discord server!","discord_already_member":"Your roles have been updated on the partner Discord server.","discord_join_error":"Failed to join the partner Discord server.","discord_joined":"Already Joined","payout_dialog_description":"Request a payout of your available commission balance","payout_available_label":"Available for payout","payout_minimum_label":"Minimum payout amount:","payout_14day_label":"14-day retention:","payout_14day_desc":"Commissions are held for 14 days after the purchase. Only commissions older than 14 days are included in the available balance.","payout_legal_form":"Legal Form","payout_natural_person":"Natural Person","payout_company":"Company","payout_first_name":"First Name","payout_last_name":"Last Name","payout_company_name":"Company Name","payout_address_section":"Address","payout_street":"Street","payout_house_number":"House No.","payout_postal_code":"Postal Code","payout_city":"City","payout_state_region":"State/Region (optional)","payout_country":"Country","payout_payment_method":"Payment Method","payout_paypal_email":"PayPal Email","payout_paypal_limit_exceeded":"Your payout amount exceeds the PayPal limit of €%limit%. Bank transfer is required.","payout_bank_transfer":"Bank Transfer","payout_account_holder":"Account Holder","payout_bank_country":"Bank Country","payout_vat_id":"VAT ID (optional)","payout_vat_id_hint":"If you have a VAT ID, please provide it here. You are responsible for any applicable taxes.","payout_vat_id_error_prefix":"The VAT ID must match the selected country and start with %prefix%.","payout_vat_id_error_format":"Invalid VAT ID format.","payout_vat_id_checking":"Verifying VAT ID with the German Federal Central Tax Office ...","payout_vat_id_confirmed":"VAT ID confirmed.","payout_vat_id_mismatch":"VAT ID is valid, but the name or address does not match the registered data.","payout_vat_id_not_registered":"This VAT ID is not assigned or not valid right now.","payout_vat_id_unconfirmed":"Verification is unavailable right now. We will check the number manually before the payout.","payout_vat_id_support_hint":"Sure that your VAT ID is correct?","payout_vat_id_support_link":"Contact support","referral_code_format_hint":"3-13 alphanumeric characters","display_name_placeholder":"Your Channel Name","platform_label":"Platform","platform_placeholder":"Select your main platform","channel_url_label":"Channel / Profile URL","channel_url_hint":"Enter the full URL to your channel or profile","apply_country":"Country","additional_info":"Additional Information","cc_message_placeholder":"Tell us about your content, audience, and why you\'d like to partner with LabyMod...","server_domain_label":"Server Domain","server_domain_hint":"Enter your server\'s domain (e.g., play.hypixel.net or mc.example.com). Servers without a custom domain cannot apply for a partnership.","sp_message_placeholder":"Tell us about your server, player count, and why you\'d like to partner with LabyMod...","submit_error":"Failed to submit application. Please try again.","domain_verified":"Domain Verified","domain_verified_desc":"You have proven ownership of %domain%","domain_pending":"Domain Verification Pending","domain_pending_desc":"Add the following TXT record to your domain\'s DNS settings to verify ownership.","dns_txt_record":"DNS TXT Record","dns_host_name":"Host / Name","dns_full_record":"Full record: %host%.%domain%","dns_value_content":"Value / Content","copied_to_clipboard":"Copied to clipboard!","add_dns_cloudflare":"Add DNS Record in Cloudflare","dns_instructions_title":"How to add a TXT record:","dns_step_login":"Log in to your domain registrar or DNS provider","dns_step_navigate":"Navigate to DNS settings for your domain","dns_step_add":"Add a new TXT record with the values above","dns_step_wait":"Wait a few minutes for DNS propagation","dns_step_verify_button":"Click the button below to verify","checking_dns":"Checking DNS...","verify_domain":"Verify Domain","dns_not_found_error":"DNS record not found. Please check your DNS settings and try again.","dns_propagation_info":"DNS changes can take up to 24 hours to propagate. We\'ll also check automatically every 5 minutes.","domain_verification_required":"Domain Verification Required","domain_verification_required_desc":"To apply as a server partner, you need to verify ownership of your domain by adding a DNS TXT record.","start_verification":"Start Verification","starting":"Starting...","app_status_pending":"Pending Review","app_status_ready":"Ready to Invite","app_status_accepted":"Accepted","app_status_denied":"Denied","app_status_banned":"Banned","app_submitted_on":"Submitted on","app_platform_type":"Platform / Type","app_your_message":"Your Message","app_denial_reason":"Reason for Denial","invoice_number":"Invoice %reference%","become_partner":"Become a Partner","sign_in_to_join":"Sign in to get started","benefit_ugc":"UGC Campaigns","benefit_ugc_desc":"Post TikToks and Shorts for active campaigns and get paid per view, straight into your commission balance. The easiest money in Minecraft content.","cc_perk_ugc":"Get paid per view with UGC campaigns","upgrade":{"locked_title":"Not unlocked yet","locked_hint":"These features are still locked for your partnership. Request an upgrade and our team will review your channels.","locked_badge":"Locked","locked_discord_desc":"Access the exclusive partner Discord with a direct line to the team.","locked_giveaways_desc":"Create promo codes for giveaways to your community.","locked_items_desc":"Add exclusive cosmetics straight to your own inventory.","locked_sprays_desc":"Create your own spray pack for your Twitch subscribers and YouTube members.","locked_vip_title":"VIP Rank","locked_vip_desc":"Show off an exclusive VIP rank in-game.","title":"Request an upgrade","pitch":"Your channels have grown? Show us. After a short review our team unlocks the remaining partner features for you.","cta":"Request an upgrade","requested":"Upgrade requested","requested_hint":"Your request is under review. We will get back to you as soon as there is news.","dialog_desc":"Tell us briefly how your channels have grown. Our team reviews every request personally.","message_label":"What has changed?","message_placeholder":"New subscriber counts, viral videos, a regular upload schedule ...","submit":"Send request","toast_success":"Request submitted! We will review it as soon as possible.","toast_error":"Something went wrong. Please try again."},"panel_active_badge":"Active partnership","affiliate_onboarding":{"title":"Set your creator code","description":"Your creator code earns you money on every purchase: whenever someone buys through your link or enters your code in the shop, you earn commission, paid out via your commission balance.","cta":"Claim code","toast_success":"Creator code claimed! The affiliate program is now active for you.","toast_error":"The code could not be saved. It might already be taken."},"home_promo_new":"New","home_promo_subtitle":"Get paid per view for your clips, release your own spray pack and treat your community with giveaway codes.","meta_title":"Partner Program - Earn with Your Content","meta_description":"Join the LabyMod partner program. Creators get their own cosmetics, a referral code and a share of revenue from the players they bring in."},"creator":{"title":"Creator","loading":"Loading creator...","error_title":"Error","error_load":"Failed to load creator","not_found":"Creator Not Found","no_items":"No items found for creator \\"%name%\\"","type_cosmetics":"Cosmetics","type_emotes":"Emotes","type_plus":"Laby+","type_stickers":"Stickers","type_bundles":"Bundles","type_coins":"Coins","type_giftcards":"Gift Cards","type_flatrate":"Flatrate","type_options":"Options","type_credits":"Credits"},"home":{"title":"Home","meta_title":"Laby - Minecraft Profiles, Skins & Capes","meta_description":"Your Minecraft hub: look up any player profile, browse thousands of skins and capes, check free names and download LabyMod, the free Minecraft client.","hero_title":"Your Minecraft Hub","hero_subtitle":"Skins, profiles, servers & more. All in one place.","search_placeholder":"Search players, skins or servers...","trending_skins":"Trending Skins","more_badges":"More Badges","search":{"no_results":"No results found","searching":"Searching","recent":"Recent","suggested":"Suggested","profiles":"Profiles","capes":"Capes","skins":"Skins","servers":"Servers","uses":"uses","skins_count":"skins","clear":"Clear search"}},"client":{"badge":"The Next Generation Minecraft Client","title":"LabyMod Client","hero_description":"The successor to LabyMod. Built from the ground up for <1>performance</1>, <2>customization</2>, and the ultimate Minecraft experience.","download":"Download Client","learn_more":"Learn More","preview_placeholder":"Client Screenshot/Video Preview","why_title":"Why Laby Client?","feature_fast_title":"Lightning Fast","feature_fast_description":"Optimized performance with minimal resource usage. Experience Minecraft like never before with smooth FPS and low latency.","feature_customizable_title":"Fully Customizable","feature_customizable_description":"Design your perfect client with extensive customization options. From HUD layouts to themes, make it yours.","feature_secure_title":"Secure & Safe","feature_secure_description":"Built with security in mind. Regular updates and a dedicated team ensure your safety while gaming.","feature_addons_title":"Addon System","feature_addons_description":"Powerful addon API for developers. Create and share custom features with the community.","feature_community_title":"Active Community","feature_community_description":"Join millions of players worldwide. Get support, share creations, and connect with fellow gamers.","feature_setup_title":"Easy Setup","feature_setup_description":"Get started in minutes. One-click installer with automatic updates keeps you always up to date.","cta_title":"Ready to upgrade your Minecraft experience?","cta_description":"Download Laby Client today and join the next generation of Minecraft players.","cta_button":"Download Now - Free","page_description":"The next generation Minecraft client. Built for performance, customization, and the ultimate Minecraft experience.","road_to_client":{"meta_title":"Road to Laby Client: Update Roadmap","meta_description":"Our development roadmap for LabyMod 4.x: a transparent look at all the updates we\'ve shipped.","badge":"Development Roadmap","cancelled_badge":"LabyMod 5","hero_title_1":"Road to","hero_title_2":"Laby Client","hero_description":"Our new strategy: instead of waiting for one big release, we ship regular, focused updates. Faster, more transparent, better for you.","context_label_old":"The old plan","context_label_new":"The new direction","hero_context_1":"We originally planned <strong>LabyMod 5</strong> as one massive release that would replace <strong>LabyMod 4</strong>. <strong>We decided against it.</strong><br><br><strong>The problem:</strong> finished features are held back for months because they need to be part of one big package. Features that have been ready for you for a long time stay hidden, just so the LabyMod 5 release feels \\"big\\" and \\"complete\\".","hero_context_2":"Instead of holding everything back until it\'s \\"perfect\\", we now ship every improvement as soon as it\'s ready. Update by update, step by step. Long-term, the version number won\'t matter anymore.<br><br><strong>LabyMod is becoming Laby Client</strong>: a single, cohesive client that keeps getting better with every update, without you ever having to wait for a big drop.","strategy_title":"Our New Approach","strategy_description_1":"We have rethought how we develop LabyMod. Instead of collecting everything for one big release like \\"Slay Mode 5\\", we now ship small, focused updates on a regular basis.","strategy_description_2":"This means you get new features faster, we can respond to your feedback quickly, and our development stays transparent at all times.","strategy_benefit_1_title":"Faster Updates","strategy_benefit_1_desc":"Regular releases every few weeks instead of waiting months for a single big drop.","strategy_benefit_2_title":"More Transparent","strategy_benefit_2_desc":"You always know what we\'re working on and what\'s coming next.","strategy_benefit_3_title":"Better Quality","strategy_benefit_3_desc":"Smaller scopes mean more focus and higher quality for each individual feature.","timeline_title":"Update Roadmap","timeline_subtitle":"Where we started, and where we stand today","status_released":"Released","status_upcoming":"Up Next","status_planned":"Planned","current_version_badge":"Current Version","v44_title":"The Friends Update","v44_description":"The Friends Update is all about playing together. Sharing worlds and servers is easier than ever, you can see at a glance where your friends are playing and join them directly. And Motion Blur has been completely reworked on top of that.","v45_title":"The Compatibility Update","v45_description":"The Compatibility Update makes LabyMod compatible with the vast majority of the most popular Forge and Fabric mods. Just play with the mods you love, and LabyMod runs alongside them. And with the new Launcher you can put together your own mod pack and jump straight in, without having to worry about compatibility.","v45_launcher_badge":"Includes: Laby Launcher 3.0","v45_launcher_desc":"<strong>Completely new design, completely new structure.</strong><br>Create and fully customize instances, launch not just LabyMod but also <strong>Vanilla, Fabric, and other modloaders</strong>, and import instances from other launchers. Everything runs noticeably faster and smoother.<br><br>A perfect match with the Compatibility Update: <strong>browse mods directly in the launcher</strong>, build your own modpacks, or just download existing ones.","v45_launcher_link":"Learn more about the Launcher","v46_title":"The Settings Update","v46_description":"The Settings Update gave LabyMod a completely new settings structure. Clearer, more intuitive, and far easier to navigate. Settings, mods, add-ons, and widgets all come together in one central place, instead of being scattered across different menus.\\n\\nThe Widget Editor now lives directly in the settings. Manage your HUD widgets and all client settings side by side, in one place, without switching between menus.\\n\\nOn top of that, the entire interaction concept has been reworked. Widgets can be dragged directly out of the settings and placed anywhere on your HUD, and many settings come with a live preview so you can see exactly what a change does before you apply it.","future_title":"And beyond...","future_description":"The future is still taking shape. Stay tuned for more updates coming your way.","previous_releases_label":"Previous Releases","beta_key_eyebrow":"LabyMod 5 Beta Key","beta_key_title":"Early access for Beta testers","beta_key_description":"Had a LabyMod 5 Beta Key? Your early access doesn\'t stop here. You\'ll get priority access to every upcoming update before anyone else. We\'ll keep you in the loop separately.","disclaimer":"This page reflects the updates we\'ve shipped so far. We\'ll keep you updated as soon as there\'s more to share.","community_eyebrow":"Shape the Future","community_title":"LabyMod is what you make it.","community_description_1":"LabyMod didn\'t start with a master plan. It grew because players asked for things — and almost every feature that makes LabyMod what it is today started as a <strong>wish from the community</strong>.","community_description_2":"That\'s not changing. If anything, it\'s becoming more intentional. With a faster release cadence, ideas can go from suggestion to shipped in weeks, not years. Your voice has a direct line to what actually ships.","community_cta":"Submit feedback","cta_title":"Ready to try it?","cta_description":"Download the latest version and experience frequent updates firsthand.","download_now":"Download LabyMod","back_to_client":"Back to Client"}},"user_selector":{"placeholder":"Select a player...","search":"Search by username...","friends":"Friends","recent":"Recently Visited","results":"Search Results","no_results":"No players found","type_to_search":"Type a username to search"},"device_link":{"title":"Link a device","subtitle":"Enter the code shown on your device.","code_label":"Device code","continue":"Continue","invalid_code":"That code is invalid or has expired.","description":"%app% wants to access your account %user%.","approve":"Link device","approved_title":"Device linked","approved_hint":"You can go back to your device now.","denied_title":"Request declined","denied_hint":"The device was not given access.","decide_failed":"Could not complete the request."},"oauth":{"authorize":{"loading":"Loading authorization request...","processing":"Processing...","redirecting":"Redirecting...","error_title":"Authorization Error","missing_params":"Missing required parameters.","load_error":"Failed to load authorization request.","auth_failed":"Authorization failed.","official_app":"Official Laby App","verified_owner_of":"Verified owner of %domain%","description":"%app% wants to access your account %user%.","scopes_header":"This will allow the application to:","authorize_btn":"Authorize","select_account_title":"Choose an account","select_account_subtitle":"Select which account you want to continue with.","cont