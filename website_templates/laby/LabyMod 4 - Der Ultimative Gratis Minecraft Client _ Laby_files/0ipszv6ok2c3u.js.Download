ymod emotes, minecraft wings, labymod pets, labycoins, laby+","item_title":"%item% - LabyMod %category%","item_title_generic":"%item% - LabyMod Cosmetic for Minecraft","item_description":"Get %item% for Minecraft in the Laby Shop: a %category% cosmetic for LabyMod, visible to every LabyMod player on any server and wearable with any skin.","item_description_generic":"Get %item% for Minecraft in the Laby Shop. A LabyMod cosmetic that works on every server, stays visible to other LabyMod players and fits any skin.","coins":{"meta_title":"LabyCoins - Buy Minecraft Shop Currency","meta_description":"Top up LabyCoins and spend them on cosmetics, emotes and pets in the Laby Shop. Larger packages cost less per coin and your balance never expires."},"tab":{"featured":{"nav":"Featured","meta_title":"LabyMod Shop - Minecraft Cosmetics, Emotes & Pets","meta_description":"The official LabyMod shop: wings, hats, cloaks, auras, pets and emotes for your Minecraft character. Visible on every server, for every LabyMod player."},"headwear":{"nav":"Headwear","item_noun":"Headwear","meta_title":"Minecraft Headwear - Hats, Halos & Masks | LabyMod","meta_description":"Hats, headgear, halos and face cosmetics for your Minecraft character in the LabyMod shop. Visible to every LabyMod player on any server."},"bodywear":{"nav":"Bodywear","item_noun":"Bodywear","meta_title":"Minecraft Bodywear - Cloaks, Backpacks & Arms | LabyMod","meta_description":"Cloaks, back items, arm and leg cosmetics and underglow for your Minecraft character in the LabyMod shop. Worn over any skin."},"wings":{"nav":"Wings","item_noun":"Wings","meta_title":"Minecraft Wings - Angel, Dragon & Demon | LabyMod","meta_description":"Animated wings for your Minecraft character in the LabyMod shop: angel, dragon, demon and elytra styles, visible to every LabyMod player."},"auras":{"nav":"Auras","item_noun":"Aura","meta_title":"Minecraft Auras - Particle Effects | LabyMod","meta_description":"Particle auras that surround your Minecraft character in the LabyMod shop: flames, sparks, hearts and elemental effects, seen by every LabyMod player."},"pets":{"nav":"Pets","item_noun":"Pet","meta_title":"Minecraft Pets - Companions for LabyMod","meta_description":"Pets that follow your Minecraft character in the LabyMod shop: dogs, cats, dragons and flying companions, visible to every LabyMod player."},"minimes":{"nav":"MiniMes","item_noun":"MiniMe","meta_title":"MiniMe - Your Minecraft Skin as a Pet | LabyMod","meta_description":"The MiniMe turns your own Minecraft skin into a small companion that follows you. Available in the LabyMod shop, visible to every LabyMod player."},"emotes":{"nav":"Emotes","item_noun":"Emote","meta_title":"Minecraft Emotes - Dances & Animations | LabyMod","meta_description":"Emotes for Minecraft in the LabyMod shop: dances, poses and animations you trigger in-game, seen by every LabyMod player on any server."},"bundles":{"nav":"Bundles","item_noun":"Bundle","meta_title":"LabyMod Bundles - Cosmetic Sets for Minecraft","meta_description":"Cosmetic bundles in the LabyMod shop: matching wings, headwear, auras and pets in one set, cheaper than buying each piece on its own."},"plus":{"nav":"Laby+","meta_title":"Laby+ - Membership for LabyMod & laby.net","meta_description":"Laby+ adds exclusive cosmetics, a LabyCoin boost and premium features across LabyMod, laby.net and Laby World. One-time payment, no subscription."},"marketplace":{"nav":"Marketplace","meta_title":"Marketplace - Buy cosmetics from other players","meta_description":"Browse LabyMod cosmetics and emotes offered by other players. Second-hand items, transferred directly from the seller after purchase."}}}},"partner":{"sprays":{"title":"Spray Pack","subtitle":"Reward your Twitch subscribers and YouTube members with your own sprays.","login_prompt":"Log in to manage your spray pack.","back_to_panel":"Back to panel","not_eligible_title":"Spray packs are for content creators","reason_not_partner":"You need to be a content creator partner to create a spray pack.","reason_level_too_low":"Your partner level is too low for spray packs. Reach the next level to unlock this feature.","become_partner":"Join the partner program","platforms_title":"Platforms","platforms_subtitle":"Connect your channels so subscribers and members receive your sprays automatically.","connect":"Connect","grant_permission":"Grant permission","enable":"Enable","disable":"Disable","enabled":"Active","connected":"Connected","not_connected":"Not connected","scope_granted":"Permission granted","scope_missing":"Permission required","audience":"Audience","granted":"Sprays granted","webhook_active":"Live sync active","last_synced":"Last synced","never_synced":"Never","error_scope_missing":"The required permission is missing. Please grant it and try again.","error_not_connected":"Connect your account first.","error_channel_already_linked":"This channel is already linked to another spray pack.","error_eventsub_failed":"We could not set up the live sync. Please try again later.","error_generic":"Something went wrong. Please try again.","create_title":"Create your spray pack","create_subtitle":"Give your pack a name to get started.","name_label":"Pack name","name_placeholder":"My spray pack","create":"Create pack","rename":"Rename","save":"Save","status_draft":"Draft","status_live":"Live","status_disabled":"Disabled","publish":"Publish","unpublish":"Unpublish","publish_hint":"Add at least one spray before publishing.","content_warning_text":"By uploading you confirm you hold the rights to these images. Copyright violations or otherwise prohibited content lead to removal of the pack and exclusion from the partner program.","delete":"Delete pack","delete_confirm":"Delete your spray pack, its sprays and all grants? This cannot be undone.","sprays_title":"Sprays","sprays_count":"%count% / %max% sprays","add_spray":"Add spray","max_reached":"You reached the maximum of %max% sprays.","spray_name":"Name","spray_name_placeholder":"Spray name","spray_tags":"Tags","spray_tags_placeholder":"tag1, tag2","replace_image":"Replace image","delete_spray":"Delete spray","delete_spray_confirm":"Delete this spray?","set_preview":"Set as pack preview","preview_badge":"Preview","no_sprays":"No sprays yet. Add your first one.","upload_title":"Upload spray","toast_saved":"Saved","toast_error":"Something went wrong"},"ugc":{"title":"UGC Campaigns","login_prompt":"Log in to submit videos and view your earnings.","not_available_title":"Not available","not_available_text":"UGC campaigns aren\'t available for your account yet.","banner_title":"Create. Post. Earn.","banner_text":"Pick a campaign, post a video and select it from your connected account. Approved videos earn based on their views.","payout_note":"Earnings are paid out via your commission balance.","open_commission":"Go to commission","stat_locked":"Locked earnings","stat_pending":"Pending (estimated)","stat_approved":"Approved videos","payout_coins_title":"Get paid in LabyCoins","payout_coins_desc":"Receive your UGC earnings as LabyCoins at %rate% coins per euro, double the cash value.","payout_coins_enabled":"You\'ll now be paid in LabyCoins","payout_coins_disabled":"You\'ll now be paid in euros","available_campaigns":"Available campaigns","no_campaigns":"No active campaigns right now. Check back soon.","ends":"Ends","submit_video":"Submit video","show_more":"Show more","show_less":"Show less","your_submissions":"Your submissions","your_submissions_desc":"Track the status, views and earnings of every video you submitted.","no_submissions":"No submissions yet.","no_submissions_hint":"Pick a campaign above to get started.","col_campaign":"Campaign","col_video":"Video","col_views":"Views","col_earnings":"Earnings","col_submitted":"Submitted","col_status":"Status","col_feedback":"Feedback","open":"View","pending_suffix":"pending","status_open":"In review","status_approved":"Approved","status_paid":"Paid","status_rejected":"Rejected","status_expired":"Expired","submit_dialog_title":"Submit a video","submitting":"Submitting…","submit_for_review":"Submit for review","toast_submitted":"Video submitted for review","toast_submit_failed":"Failed to submit video","reward_per_1000":"€%rate% / 1,000 views","reward_cap":"(up to €%cap%)","reward_tiered":"Up to €%amount% at %views% views","reward_fixed":"€%amount% per approved video","card_subtitle":"Create videos and earn based on views","open_ugc":"Open UGC","connect_title":"Connect your %platform% to get started","connect_subtitle":"Submissions must come from your own connected %platform% account so we can verify them and track views.","connect_button":"Connect %platform%","connecting":"Connecting…","reconnect_title":"Automatic view tracking is off","reconnect_text":"Your %platform% account was linked before automatic tracking was available, so we can\'t refresh views automatically. Reconnect once to turn it on.","reconnect_button":"Reconnect %platform%","step1_title":"Connect %platform%","step1_text":"Link the account you post from.","step2_title":"Post your video","step2_text":"Create and upload your video for the campaign using its hashtag.","step3_title":"Select your video","step3_text":"Pick it from your uploads here. We verify it\'s yours and track the views.","video_url_generic_label":"Video URL","submit_dialog_desc_generic":"Paste the link to your public video for this campaign.","pick_video_label":"Choose one of your %platform% videos","loading_videos":"Loading your videos…","no_videos":"No videos found on your connected account.","no_videos_since_start":"No videos uploaded since this campaign started. Only videos posted after the campaign start can be submitted.","videos_before_start_hidden":"Videos uploaded before the campaign started are hidden and can\'t be submitted.","submit_dialog_desc_pick":"Pick the video you posted for this campaign. Only videos from your connected account are shown.","youtube_shorts_hint":"Only YouTube Shorts count for this campaign (videos up to 3 minutes). Longer uploads are rejected.","commission_item":"UGC campaign reward","sales_legend":"UGC campaigns","campaign_column":"UGC campaign","max_submissions":"max %count% per creator","panel_campaigns_none":"No active campaigns right now","panel_campaigns_one":"1 campaign available now","panel_campaigns_many":"%count% campaigns available now","reward_up_to":"Earn up to","per_video":"per video","your_rate":"Your rate","per_thousand":"per 1,000 views","tier_from":"from %views% views","min_duration":"min. %seconds%s length","banner_title_1":"Create. Post.","banner_title_2":"Get paid.","payout_timing":"Views count for %countingDays% days after your video\'s upload. The count at that cutoff decides your reward; it is paid out %holdDays% days later.","tier_hint":"You earn the amount of the highest tier you reach (tiers don\'t add up).","phase_counting_title":"Counting","phase_counting_text":"After approval, views count for a fixed window starting at your video\'s upload date.","phase_cutoff_title":"Cutoff","phase_cutoff_text":"The view count on the cutoff date locks in your reward. Later views no longer change it.","phase_hold_title":"Hold","phase_hold_text":"The locked-in amount is held for a few days to protect against fake views and corrections.","phase_payout_title":"Payout","phase_payout_text":"The amount is credited to your commission balance.","how_zero_hint":"Seeing 0 € although you already reached a tier? Your reward is only locked in at the cutoff and paid after the hold period. Until then it shows as an estimate.","views_settled":"%views% at cutoff","counting_until":"Counting until","earn_estimate":"estimated","earn_locked_in":"locked in","payout_on":"Payout on","uploaded_prefix":"Uploaded:"},"ugc_terms":{"title":"UGC Creator Program","pitch":"Earn money with videos about LabyMod. Join the creator program to pick campaigns, post videos and get paid based on views.","terms_heading":"Participation terms","term_1_title":"Eligibility","term_1_text":"The UGC program is open to active LabyMod content creator partners only. Participation is per campaign, and joining one campaign does not grant access to others.","term_2_title":"Your own content","term_2_text":"You may only submit videos that are your own original content, published on your own connected account. Re-uploads, stolen content or clips you do not hold the rights to are not allowed.","term_3_title":"Platform rules and law","term_3_text":"Your content must comply with the terms of the platform it is posted on (TikTok, YouTube or Instagram) and with all applicable laws.","term_4_title":"Advertising disclosure","term_4_text":"Videos created for a paid campaign must be clearly labeled as advertising, following the rules of the platform and applicable law (for example #ad or Werbung).","term_5_title":"Statistics tracking","term_5_text":"By submitting a video you allow us to fetch its public statistics such as views, likes and comments through the platform APIs, so we can calculate your payout.","term_6_title":"Payouts","term_6_text":"Rewards follow the payout model published for each campaign (per view, tiers or a fixed amount). Payouts are subject to per-video and campaign budget caps and a hold period, and are paid out through your partner commission balance.","term_7_title":"No fraud","term_7_text":"Artificially inflated views or engagement, for example through bots or view farms, lead to rejection of the video, forfeiture of pending earnings and exclusion from the program.","term_8_title":"Changes and termination","term_8_text":"We may adjust campaigns, rewards and these terms at any time or end the program entirely. Access can be revoked if you violate these terms.","checkbox_label":"I have read and accept the participation terms.","accept_button":"Accept and join","accepting":"Joining…","success_toast":"Welcome to the UGC program!","error_toast":"Something went wrong. Please try again.","error_forbidden":"The UGC program is only available for content creator partners."},"title":"Partner","cloak_title":"Elite Cloak","commission_title":"Commission","invoice_title":"Payout Invoice","program_title":"Partner Program","program_subtitle":"Join the LabyMod partner program and unlock exclusive benefits","partnership_types":"Partnership Types","content_creator":"Content Creator","content_creator_description":"For YouTubers, Twitch streamers, and social media influencers who create Minecraft-related content. Share your platform and reach with us.","server_partner":"Server Partner","server_partner_description":"For Minecraft server owners who want to integrate LabyMod features and offer exclusive perks to their players.","server_specific_features":"Access to server-specific features","sign_in_to_apply":"Sign In to Apply","apply_sign_in_required":"Sign in to apply for the partner program","apply_sign_in_title":"Sign in Required","apply_sign_in_description":"You need to sign in to your Laby account before you can apply for the partner program.","back_to_landing":"Back to Partner Page","already_partner_title":"You\'re Already a Partner!","already_partner_desc":"You have an active partnership. Visit your partner panel to manage it.","application_status_title":"Application Status","apply_cc_title":"Content Creator Application","apply_cc_subtitle":"Link your channels and join instantly, no application needed.","self_service":{"requirement":"You need at least %count% videos with %views%+ views each on YouTube or TikTok, posted in the last %months% months.","requirement_twitch":"At least %viewers%+ average viewers on Twitch (last 30 days).","requirement_hint":"We count your best recent videos from every channel you link, so linking more platforms helps.","connect_heading":"Link your platforms","platform_connected":"Connected","connect":"Connect","connecting":"Connecting...","join_button":"Check eligibility and join","join_loading":"Checking your channels...","join_loading_hint":"We are fetching your videos from the platforms, this can take a few seconds.","join_need_platform":"Link at least one platform to continue.","success_title":"You are in!","success_subtitle":"Welcome to the partner program","success_desc":"You now have access to the partner panel: UGC campaigns and your personal referral code are waiting for you.","success_cta":"Go to Partner Panel","result_title":"Almost there","result_progress":"%current% of %required% qualifying YouTube/TikTok videos (last 12 months)","twitch_progress":"%current% avg. viewers on Twitch (need %required%+)","result_hint":"Link another platform or come back once your videos have grown, then try again.","result_hint_error":"We couldn\'t check one of your platforms. Reconnect it and try again, or just apply anyway and we\'ll review it by hand.","platform_not_connected":"Not connected","platform_check_failed":"We couldn\'t check this connection.","platform_reconnect":"Reconnect","stat_qualifying":"Qualifying","stat_checked":"Checked","stat_top":"Top views","stat_avg_viewers_unavailable":"Twitch viewer data unavailable","toast_already_partner":"You are already a partner or have an open application.","toast_no_platform":"Link at least one platform before you join.","toast_error":"Something went wrong. Please try again.","classic_hint":"Don\'t want to link an account, or creating on a platform like Instagram?","classic_link":"Apply the classic way instead","apply_anyway":"Apply anyway","back_to_self_service":"Back to self-service","classic_form_desc":"Tell us about your platform and audience. Our team will review your application manually, this can take a few days.","coming_soon":"Coming soon","change_account":"Change"},"apply_flow":{"step_start":"Start","step_connect":"Channels","step_check":"Check","step_result":"Result","intro_subtitle":"Your content does the convincing, not a cover letter. No forms, no waiting for a review.","intro_cta":"Let\'s go","perk_cosmetics":"Exclusive cosmetics","perk_giveaways":"Giveaway codes","perk_commission":"Commission","perk_badge":"Partner badge","how_connect_title":"Connect a channel","how_connect_desc":"YouTube, TikTok or Twitch","how_check_title":"Auto check","how_check_desc":"Your stats, checked in seconds","how_partner_title":"Instant partner","how_partner_desc":"Full access to the partner panel","connect_title":"Connect your channels","connect_subtitle":"One channel is enough. Every extra platform raises your chances.","connect_requirements_title":"What you need","or":"or","popup_note":"A popup opens where you sign in to the platform.","check_cta":"Start the check","back":"Back","checking_1":"Connecting to your platforms ...","checking_2":"Counting your videos ...","checking_3":"Adding up your views ...","checking_4":"Comparing with the requirements ...","success_badge":"Check passed","success_title":"You are a partner!","noteligible_subtitle":"You do not meet the requirements quite yet. Here is where you stand:","noteligible_connect_more":"Connect another platform","classic_title":"Classic application","classic_done_title":"Application submitted!","classic_done_desc":"Our team reviews your application personally. You will usually hear back within a few days. You can check the status on this page anytime.","noteligible_videos_label":"Qualifying YouTube/TikTok videos (last 12 months)","intro_title_1":"Become a partner.","intro_title_2":"In minutes."},"apply_sp_title":"Server Partner Application","apply_sp_subtitle":"Verify your domain and tell us about your server.","submitting":"Submitting...","submit_application":"Submit Application","hero_title_1":"Create More.","hero_title_2":"Earn More.","hero_subtitle":"Earn real money with your content: per view in UGC campaigns, through your referral code and with commission on your own cosmetics.","hero_apply_now":"Apply Now","hero_go_to_panel":"Go to Partner Panel","hero_learn_more":"Learn More","trust_free_to_join":"Free to join","trust_no_minimum":"No minimum followers","trust_real_earnings":"Real earnings","benefits_title":"What you get","benefits_subtitle":"Tools and perks to grow your community and earn along the way.","benefit_exclusive_items":"Exclusive Cosmetics","benefit_exclusive_items_desc":"Capes, bandanas, emotes and more. Submit your own cosmetics and earn commission on every single sale.","benefit_giveaway_codes":"Giveaway Codes","benefit_giveaway_codes_desc":"Generate promo codes that unlock premium shop items for anyone who redeems them","benefit_commission":"Affiliate Commission","benefit_commission_desc":"Real money on every purchase made through your personal referral code, paid out to you.","benefit_priority_support":"Priority Support","benefit_priority_support_desc":"Direct access to a dedicated partner support channel","benefit_elite_cloak":"Elite Cloak","benefit_elite_cloak_desc":"Design and submit your own animated cloak texture","benefit_partner_badge":"Partner Badge","benefit_partner_badge_desc":"Get a verified partner badge on your profile and a role in our community","sub_sync_badge":"Subscriber Sync","sub_sync_title":"Reward Your Subscribers","sub_sync_subtitle":"Connect your Twitch or YouTube channel and automatically grant exclusive in-game perks to your subscribers and members.","sub_sync_perk_spray":"Exclusive Spray Pack","sub_sync_perk_cosmetics":"Unique Cosmetics","sub_sync_perk_auto":"Auto Sync","types_title":"Two ways to partner","cc_tagline":"For streamers, YouTubers & influencers","cc_perk_items":"Self-add exclusive cosmetics to your inventory","cc_perk_giveaway":"Create codes for giveaways to your audience","cc_perk_commission":"Earn real money with your personal referral code","cc_perk_cloak":"Submit your own cosmetics and earn on every sale","sp_tagline":"For Minecraft server owners","sp_perk_team":"Manage team members with granular permissions","sp_perk_items":"Grant exclusive items to your server team","sp_perk_api":"Access the server partner API for integrations","sp_perk_features":"Server-specific features & customization","cta_title":"Ready to get started?","cta_description":"Apply for free. No follower requirements, no hidden fees.","ugc_landing_badge":"Early Access","ugc_landing_marquee_program":"Creator Program","ugc_landing_marquee_paid":"Paid per Views","ugc_landing_marquee_clips":"Clips","ugc_landing_marquee_early":"Early Access","ugc_landing_marquee_platforms":"TikTok & Shorts","ugc_landing_title_1":"Post Clips.","ugc_landing_title_2":"Get Paid Per View.","ugc_landing_subtitle":"Our new UGC program pays you for the views your TikToks and Shorts generate. Pick a campaign, post your clip and watch your views turn into money.","ugc_landing_step1_title":"Pick a campaign","ugc_landing_step1_text":"Choose an active UGC campaign with a brief that fits your content.","ugc_landing_step2_title":"Post your clip","ugc_landing_step2_text":"Publish it on TikTok or YouTube Shorts with your connected account.","ugc_landing_step3_title":"Earn per view","ugc_landing_step3_text":"Your views convert into real money, paid into your commission balance.","ugc_landing_views_label":"Views","ugc_landing_earnings_label":"Earnings","ugc_landing_disclaimer":"Illustrative numbers. Actual rates vary per campaign.","ugc_landing_cta_note":"UGC campaigns are in early access. Your partner manager unlocks them for you after you join as a Content Creator.","ugc_landing_open_panel":"Open UGC Campaigns","payout_invoice":"Payout Invoice","login_to_view_invoice":"Please log in to view your payout invoice.","invoice_pdf_subtitle":"PDF preview for your affiliate payout invoice","open_pdf":"Open PDF","invoice_preview_hint":"If the preview does not load in your browser, use","invoice_preview_hint_suffix":"instead.","back_to_commission":"Back to Commission","status_pending":"Pending Review","status_approved":"Approved","status_denied":"Denied","request_payout":"Request Payout","requesting":"Requesting...","payout_failed":"Failed to request payout","commission":"Commission","login_to_manage":"Please log in to manage your commissions.","back_to_panel":"Back to Panel","join_affiliate":"Join the Affiliate Program","join_affiliate_description":"Earn commissions by promoting LabyMod products to your audience. Share your unique referral link and earn a percentage of each sale.","get_started":"Get Started","join_affiliate_dialog_title":"Join the Affiliate Program","join_affiliate_dialog_description":"Once you join, you will receive a unique referral code to share with your audience.","join_program":"Join Program","joining":"Joining...","total_earnings":"Total Earnings","total_sales":"Total Sales","commission_rate":"Commission Rate","balance":"Balance","monthly_earnings":"Monthly Earnings","monthly_earnings_description":"Your commission earnings over the last 12 months","earnings":"Earnings","your_referral_codes":"Your Referral Codes","referral_codes_description":"Share these codes with your audience to earn commissions on their purchases","add_code":"Add Code","add_referral_code":"Add Referral Code","add_referral_code_description":"Create an additional referral code for your audience","referral_code":"Referral Code","creating":"Creating...","create_code":"Create Code","no_referral_codes":"No referral codes assigned yet.","settings":"Settings","sale_notifications":"Sale Notifications","sale_notifications_description":"Get notified when someone uses your referral link","recent_commissions":"Recent Commissions","recent_commissions_description":"Your most recent affiliate earnings","date":"Date","item":"Item","amount":"Amount","status":"Status","purchase":"Purchase","earned":"Earned","payouts":"Payouts","your_previous_payouts":"Your previous payouts","reference":"Reference","invoice":"Invoice","view":"View","showing_range":"Showing %start%-%end% of %total%","no_payouts_yet":"No payouts yet","payout_status":{"accepted":"Accepted","completed":"Completed","pending":"Pending","rejected":"Rejected"},"elite_cloak":"Elite Cloak","login_to_manage_cloaks":"Please log in to manage your cloaks.","content_creators_only":"Content Creators Only","content_creators_only_description":"The Elite Cloak feature is only available for Content Creator partners.","submit_texture":"Submit Texture","submit_cloak_texture":"Submit Cloak Texture","submit_cloak_texture_description":"Upload a custom animated cloak texture for review","texture_requirements":"Texture Requirements","texture_req_frames":"Animation frames should be stacked vertically","texture_req_dimensions":"Standard cloak dimensions: 22x17 pixels per frame","cloak_guidelines":{"show":"View content guidelines","title":"Cloak rules","subtitle":"By uploading your texture, you automatically accept the rules below and that you will follow them. A cloak design may not contain any of the mentioned content:","notes_title":"All rights reserved","notes":"If a ban is justified from the point of view of a staff member, it will remain valid. Staff members are not forced to justify themselves for any bans. The LabyMod team may also ban cloaks for reasons not mentioned above.","rules":{"pornographic":{"title":"Pornographic","description":"Textures that have a clear goal of sexually arousing the viewer. Logos and links pointing to pornographic websites are included, i.e. Pornography, Hentai, Models, etc."},"copyright":{"title":"Copyright","description":"The texture must be created by you and must not contain any copyrighted images."},"radical_extremism":{"title":"Radical Extremism","description":"Textures that represent and disseminate these ideologies, i.e. swastika, picture of Hitler, etc."},"unacceptable_text":{"title":"Unacceptable Text","description":"Text intended to humiliate a person, group, or attack, i.e. Trading, Insults, Degrading Behaviour, etc."},"not_funny":{"title":"Not Funny","description":"Textures intended to include \\"dark humor\\" and content advertising self-harm, i.e. Showing a violation of human rights, Bodily harm / injury, etc."},"links":{"title":"Links","description":"Textures containing any kind of link-shortener or QR-Code, i.e. Bitly, etc."}}},"cloak_texture":"Cloak Texture","texture_uploaded":"Texture uploaded","texture_uploaded_hint":"Click the X to remove and upload a different texture","click_to_upload_or_drag":"Click to upload or drag and drop","png_or_gif":"PNG or GIF","animation_delay":"Animation Delay (ms)","submit_for_review":"Submit for Review","elite_cloak_description":"As a Content Creator partner, you can submit custom animated cloak textures. Once approved, you can use them in-game and showcase them to your audience.","your_submissions":"Your Submissions","your_submissions_description":"Track the status of your cloak texture submissions","no_submissions_yet":"No submissions yet","no_submissions_hint":"Click \\"Submit Texture\\" to upload your first cloak","id":"ID","texture":"Texture","delay":"Delay","submitted":"Submitted","feedback":"Feedback","display_name_optional":"Display Name (optional)","item_sales":"Item Sales","join_now":"Join Now","login_to_view_commission":"Please log in to view your commission data","of_item_commission":"of item commission","pending_payout":"Pending Payout","referral_code_hint":"Choose a unique code for your referral link","referral_sales":"Referral Sales","total_paid_out":"Total Paid Out","panel_title":"Partner Panel","panel_welcome":"Welcome back, %name%!","panel_not_partner":"You are not a partner","panel_no_partnership":"You don\'t have an active partnership. Would you like to apply?","panel_apply_now":"Apply Now","giveaway_codes":"Giveaway Codes","giveaway_codes_description":"Share these codes with your community. %count% codes remaining this week.","create_giveaway":"Create Giveaway","create_giveaway_code":"Create Giveaway Code","create_giveaway_description":"Create a new promotional code for your community","item_to_give_away":"Item to Give Away","giveaway_name":"Giveaway Name","giveaway_name_placeholder":"e.g., Twitter Giveaway","proof_url":"Reference URL","proof_url_placeholder":"e.g., https://discord.com/..., https://twitch.tv/..., etc."