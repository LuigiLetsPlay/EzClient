nnel_desc":"This removes the repository connection and all its releases. This cannot be undone.","channel_deleted":"Channel deleted.","permissions":"Permissions","permissions_hint":"Derived automatically from your addon.json.","permission_critical":"This permission grants access to sensitive capabilities."},"releases":{"title":"Releases","new":"New release","empty":"No releases yet.","version":"Version","mc_versions":"MC versions","build":"Build","review":"Review","added":"Added","changelog":"Changelog","changelog_required":"A changelog is required.","version_required":"A version is required.","building":"Building…","build_failed":"Build failed","ready":"Ready","request_review":"Request review","review_requested":"Review requested.","in_review":"In review","approved":"Approved","denied":"Denied","not_submitted":"Not submitted","created":"Release created.","deleted":"Release deleted.","delete_title":"Delete release?","delete_desc":"Delete version %version%? This cannot be undone.","delete_last_hint":"This is the last release — deleting it will also remove the channel.","add_range":"Add range","any_version":"Any","first_release":"First release is fixed to 1.0.0.","increment_major":"major","increment_minor":"minor","increment_patch":"patch","pull_hint":"The jar is pulled from the latest successful run of %workflow% on %repository%."},"reviews":{"title":"Review history","requested":"requested","requested_by":"requested by %name%","auto":"Automatic","show_all":"Show all","show_less":"Show less","status":{"accepted":"Approved","denied":"Denied","open":"In review","withdrawn":"Withdrawn"},"changes":"Changes","comments":"%count% comments","line":"Line %line%","show_comments":"Show comments","hide_comments":"Hide comments","add_comment":"Add comment","comment_placeholder":"Leave a comment on this line…","submit_comment":"Comment","comment_cancel":"Cancel","delete_comment":"Delete comment","comment_staff":"Reviewer","general_comments":"General comments","diff_unavailable":"Diff snapshot not available","diff_too_large":"This diff is too large to display inline.","diff_no_changes":"No line changes in this file."},"danger":{"delete":"Delete addon","delete_desc":"Permanently delete this addon and all of its releases.","delete_confirm":"Type %namespace% to confirm deletion. This cannot be undone."}}},"profiler":{"file_load_error":"Error loading file: %error%"},"voicechat":{"title":"Voice Chat – Free Ingame Voice Chat for Minecraft","page_description":"Talk to other players in Minecraft with 3D Surround Sound and Proximity Audio. Free on every server, no plugins needed. Just install LabyMod and start talking.","og_title":"Voice Chat for Minecraft | LabyMod","og_description":"Free ingame Voice Chat with 3D Surround Sound. Proximity Audio on every Minecraft server. No plugins, no setup.","badge":"Voice Chat for Minecraft","hero_title_1":"Talk to the World.","hero_title_2":"Directly in Minecraft.","hero_description":"Free ingame Voice Chat with 3D Surround Sound. The closer you get to a player, the louder you hear them. On every server, no plugins needed.","download_labymod":"Download LabyMod","rules":"Voice Chat Rules","rules_page":{"title":"Voice Chat Rules","subtitle":"By using the LabyMod Voice Chat you automatically accept the rules below and that you follow them.","intro":"Any behaviour that offends, discriminates or hinders/interferes a user\'s interaction in voice chat properly is mutable.","includes":"That includes:","notes_title":"Additional notes","notes":"The advice and warnings of any member of the LabyMod staff team must be taken seriously and followed. If a mute is justified from the point of view of a staff member, it will remain valid! Mutes are only resolved in case of absolute misunderstandings. Staff members are not forced to justify themselves for any mutes!","recording_title":"Voice recording","recording":"To enable us to take action against players who use voice chat to bully, harass, discriminate or otherwise behave inappropriately, the voice chat is recorded for one minute on a rolling basis. In the event of a report, the last minute is saved and reviewed by one of our moderators. If no violation of the rules is detected, the recording will be irrevocably deleted.","rule_noise_level_title":"Too loud/disturbing noise","rule_noise_level_text":"Such as any noise used with the intention to annoy others like screaming, music/soundbots, voice distortion etc.","rule_provocation_title":"Provocation","rule_provocation_text":"Such as disrespectful and provocative behaviour towards other users of Voice Chat etc.","rule_discrimination_title":"Discrimination","rule_discrimination_text":"Such as offending people that identify themselves with another sexual orientation/gender, having a different origin, having another religion or people which get discriminated due to their impairments or for their appearance, etc.","rule_racism_title":"Racism","rule_racism_text":"Such as offending players on the basis of/due to ethnicity, skin colour, appearance, etc.","rule_extremism_title":"Extremism","rule_extremism_text":"Such as the propagation of radical phrases, etc.","rule_advertising_title":"Advertising","rule_advertising_text":"Such as excessive and annoying, repetitive promotion etc.","rule_harassment_title":"Harassment/Threat","rule_harassment_text":"Such as consistent teasing, inappropriate sexual comments, threats of violence etc.","rule_bypassing_title":"Bypassing mutes","rule_bypassing_text":"Such as connecting to Voice Chat with other accounts to bypass a mute etc.","rule_trading_title":"Trading","rule_trading_text":"Such as trying to sell or buy/get cosmetics and emotes or other things from other users etc."},"surround_badge":"3D Surround Sound","surround_title":"Hear where they are","surround_description_1":"With the Voice Chat\'s 3D Surround Sound, your Minecraft experience is taken to a new level. It feels like real life. Players nearby sound louder, distant voices get quieter.","surround_description_2":"Perfect for adventures with friends, community events, or as a streamer interacting with viewers directly in the game.","features_title":"Everything you need","feature_friends_title":"Adventures with Friends","feature_friends_description":"No Discord needed. Meet up in your world and start talking.","feature_proximity_title":"3D Proximity Audio","feature_proximity_description":"Realistic sound based on position.","feature_ptt_title":"Push-to-Talk","feature_ptt_description":"V key or voice activation.","feature_no_plugins_title":"No Plugins Needed","feature_no_plugins_description":"No setup required on any server.","feature_free_title":"Completely Free","feature_free_description":"For all LabyMod players.","feature_server_title":"On Every Server","feature_server_description":"Meet new people. Voice Chat works everywhere.","steps_title":"Get Started in 3 Steps","step_1_title":"Install LabyMod","step_1_description":"Voice Chat is included automatically","step_2_title":"Join a Server","step_2_description":"Works on every server","step_3_title":"Press V & Talk","step_3_description":"Nearby players can hear you","cta_title":"Ready to Talk?","cta_description":"Download LabyMod and use Voice Chat for free. On every server."},"app":{"title":"LabyMod App","page_description":"Your Laby account in your pocket. Manage cosmetics, collect daily rewards, discover skins and see what your friends are playing.","og_title":"LabyMod App | Laby","og_description":"Your Laby account in your pocket. Manage cosmetics, collect daily rewards, discover skins and see what your friends are playing.","badge":"iOS & Android","hero_title_1":"Manage your","hero_title_2":"Laby account","hero_description":"Your profile, streak, LabyCoins and cosmetics, always with you. The official LabyMod app for iOS and Android.","hero_card_streak":"Days Streak","hero_card_online":"Online","hero_card_reward":"Daily Reward","hero_card_reward_state":"Ready to collect","hero_card_claim":"Claim","store_apple_subtitle":"Download on the","store_apple_title":"App Store","store_google_subtitle":"Get it on","store_google_title":"Google Play","rewards_eyebrow":"Daily rewards","rewards_title":"Collect free coins every day","rewards_description":"Claim your daily reward and keep an eye on your login streak from the client, milestone after milestone. Laby+ boosts every payout.","rewards_chip_1":"Streak milestones","rewards_chip_2":"Free LabyCoins","rewards_chip_3":"Laby+ boost","cosmetics_eyebrow":"Cosmetics","cosmetics_title":"Your cosmetics in your pocket","cosmetics_description":"Browse, activate and fine-tune all your cosmetics right from your phone. Swap textures, pick colors and check the result in 3D.","cosmetics_chip_1":"Outfits","cosmetics_chip_2":"Textures & colors","cosmetics_chip_3":"3D view","discover_eyebrow":"Discover","discover_title":"Browse thousands of skins and capes","discover_description":"Trending skins, the most used capes, badges and LabyMod news, all in one feed.","shop_eyebrow":"Shop","shop_title":"Try & buy any cosmetic","shop_description":"Preview every cosmetic on your own character before you buy it with LabyCoins. Top up easily via in-app purchase or save items to your wishlist.","shop_chip_1":"Try before you buy","shop_chip_2":"Wishlist","shop_chip_3":"In-app purchases","friends_eyebrow":"Friends","friends_title":"See which server friends are on","friends_description":"Your friends list with live status: who is online and which server they are playing on right now.","friends_chip_1":"Online status","friends_chip_2":"Live server info","cta_title":"Download now","cta_description":"Free for iOS and Android. Download the app and get started right away."},"skins":{"meta_title":"Minecraft Skins - Browse & Download Free Skins","meta_description":"Browse thousands of free Minecraft skins. Find boy, girl, anime, PvP and aesthetic skins, preview them in 3D and download or apply them in one click.","meta_og_title":"Minecraft Skins | Laby","meta_og_description":"Browse trending and popular Minecraft skins.","tag_meta_description":"Browse Minecraft skins tagged with \\"%tag%\\". Find the perfect %tag% skin for your player.","tag_desc_namemc":"laby.net shows you every Minecraft player\'s profile just like NameMC: name history, skins, capes and UUID lookup, plus thousands of free skins to download.","tag_desc_skindex":"Looking for Skindex-style Minecraft skins? Browse thousands of free skins on laby.net, preview them in 3D and download or apply them directly.","tag_desc_novaskin":"Looking for a Novaskin-style editor? Create and edit Minecraft skins in 3D on laby.net, or browse thousands of free skins ready to download."},"capes":{"meta_title":"Minecraft Capes - Browse & Download Free Capes","meta_description":"Browse every Minecraft cape in one place. Migrator, MineCon and LabyMod capes with 3D preview, ready to download or wear in game with one click.","meta_og_title":"Minecraft Capes | Laby","meta_og_description":"A list of all official Minecraft capes and which players have used them.","leaderboard":{"cta":"Leaderboard","back":"Back to Capes","title":"Cape Leaderboard","subtitle":"The players who own and have worn the most official Minecraft capes.","meta_title":"Cape Leaderboard","meta_description":"The players who own the most Minecraft capes, ranked by their total cape count.","total_players":"%count% players ranked","column_rank":"Rank","column_player":"Player","column_first_discovered":"First discovered","column_capes":"Capes","column_count":"Count","view_compact":"List","view_grid":"Matrix","search_placeholder":"Search player...","search_button":"Search","search_not_found":"Player not found on the leaderboard.","empty_title":"No players yet","empty_description":"The cape leaderboard is still being calculated. Check back soon."}},"cloaks":{"meta_title":"LabyMod Cloaks - Animated Minecraft Capes","meta_description":"Discover every LabyMod cloak: animated, customisable capes that only LabyMod players can wear. Preview each one in 3D before you put it on.","meta_og_title":"LabyMod Cloaks | Laby","meta_og_description":"Browse trending and popular Minecraft cloaks.","tag_meta_description":"Browse Minecraft cloaks tagged with \\"%tag%\\". Find the perfect %tag% cloak for your player."},"bandanas":{"meta_title":"LabyMod Bandanas - Minecraft Cosmetics","meta_description":"Browse every LabyMod bandana. Colourful cosmetics your character wears in game, visible to all LabyMod players, with a 3D preview for each one.","meta_og_title":"LabyMod Bandanas | Laby","meta_og_description":"Browse trending and popular Minecraft bandanas.","tag_meta_description":"Browse Minecraft bandanas tagged with \\"%tag%\\". Find the perfect %tag% bandana for your player."},"labymod":{"meta_title":"LabyMod 4 | The Free Minecraft Client","meta_description":"Download LabyMod 4 for free. The ultimate Minecraft client with 300+ mods, 3D voice chat, cosmetics, launcher and more. Available for Windows, macOS and Linux.","meta_og_title":"LabyMod 4 | The Ultimate Free Minecraft Client","meta_og_description":"Upgrade your Minecraft experience: 300+ mods, 3D VoiceChat, cosmetics, world sharing and much more. Completely free.","meta_keywords":"LabyMod, LabyMod 4, Minecraft client, Minecraft mod, free Minecraft client, download LabyMod, Minecraft mods, voice chat Minecraft, Minecraft cosmetics, Minecraft addons, Minecraft launcher, PvP client, Minecraft performance","hero_title_prefix":"The ultimate","hero_subtitle":"More performance, more features, more possibilities. Free for everyone.","other_versions":"Other versions","roadmap_button":"Update Roadmap","whats_new":"What\'s new in %version%?","trust_free":"Free","trust_users":"5M+ Users","allinone_title_1":"One Client.","allinone_title_2":"Everything included.","allinone_description":"Over 100 mods packed into one client with its own launcher. Install it, launch it, play. It\'s that simple.","stat_installation":"Installation","stat_features":"Mods","stat_users":"Users","stat_versions":"Minecraft Versions","cta_badge":"5+ Million Players","cta_title_1":"Join the","cta_title_2":"Community","cta_description":"Download LabyMod for free and experience Minecraft like never before.","ws_badge":"World Sharing","ws_title_1":"Play with friends.","ws_title_2":"No server needed.","ws_description":"Invite your friends directly into your singleplayer world.<br/>No server setup, no port forwarding, no compromises.","ws_mobile_description":"Share your singleplayer world directly with friends. No server, no setup.","ws_feature_instant":"Start instantly","ws_feature_no_port":"No setup required","ws_feature_no_port_needed":"Works out of the box","ws_feature_plugins":"Works with server plugins","ws_feature_public":"Host publicly, get your own domain","ws_feature_secure":"Your IP stays protected and secure","hero_minecraft_client":"Minecraft Client","trust_platforms":"Windows, Mac & Linux","trust_edition":"for Minecraft Java Edition","vc_badge":"Social","vc_title_1":"Proximity Voice Chat.","vc_title_2":"On every server.","vc_description":"Communicate with other players in real time. Proximity Voice makes it possible: the closer you get to a player, the louder you hear them. You can even tell which direction their voice is coming from.","vc_no_plugins":"No server plugins needed.","vc_feature_proximity":"Proximity Audio","vc_feature_proximity_desc":"Realistic positional audio","vc_feature_ptt":"Push-to-Talk","vc_feature_ptt_desc":"Or voice activation","vc_feature_channels":"Voice Channels","vc_feature_channels_desc":"Talk privately with friends","dl_for_mac":"Download for Mac","dl_for_linux":"Download for Linux","dl_for_windows":"Download for Windows","dl_popup_title":"Download LabyMod 4","dl_popup_subtitle":"Choose the right version for your operating system","dl_launcher_title":"LabyMod Launcher","dl_launcher_latest":"latest","dl_installer_title":"Installer for Minecraft Launcher / MultiMC / Prism Launcher","dl_footer_note":"You need an official Minecraft: Java Edition account to use LabyMod.","dl_lm3_deprecated":"Looking for LabyMod 3? This version is outdated and no longer supported.","promo_subtitle":"The Ultimate Minecraft Client","promo_description":"More performance, more features, more possibilities. The ultimate client for your Minecraft experience. Completely free.","promo_download":"Download for free","promo_performance":"Performance","promo_cosmetics":"Cosmetics","promo_mods":"100+ Mods","promo_voicechat":"Voice Chat","design_badge":"Design","design_title_1":"Rethink Minecraft.","design_title_2":"Play it your way.","design_description":"Choose between the modern <span class=\'text-blue-400 font-semibold\'>Fancy</span> theme or the classic <span class=\'text-orange-400 font-semibold\'>Vanilla</span> look.<br/>Every screen is fully customizable and consistent throughout the entire client.","design_theme":"Theme","design_screen_video_name":"Video","design_screen_video_short":"Video","design_screen_main_menu_name":"Main Menu","design_screen_main_menu_short":"Menu","design_screen_main_menu_desc":"The modern main menu with all important functions at a glance","design_screen_settings_name":"Settings","design_screen_settings_short":"Settings","design_screen_settings_desc":"Configure LabyMod to your liking with hundreds of options","design_screen_multiplayer_name":"Multiplayer","design_screen_multiplayer_short":"Multiplayer","design_screen_multiplayer_desc":"Find and manage your favorite servers","design_screen_widgets_name":"Widgets","design_screen_widgets_short":"Widgets","design_screen_widgets_desc":"Customize your HUD with freely placeable widgets","design_screen_addons_name":"Addons","design_screen_addons_short":"Addons","design_screen_addons_desc":"Extend LabyMod with hundreds of community addons","design_screen_chat_name":"Chat","design_screen_chat_short":"Chat","design_screen_chat_desc":"Enhanced chat features for a better gaming experience","launcher_badge":"LabyMod Launcher","launcher_title_1":"Our Laby Launcher.","launcher_title_2":"Lightning fast.","launcher_description":"Launch Minecraft faster than ever, switch between accounts instantly, browse a full skin library, and build your own modpacks right inside the launcher.","launcher_feature_fast_title":"Lightning fast start","launcher_feature_fast_desc":"Start Minecraft in seconds, built with a focus on speed","launcher_feature_multiversion_title":"Multi-Version Support","launcher_feature_multiversion_desc":"Play any Minecraft version, from the earliest releases to the latest snapshot","launcher_feature_modpacks_title":"Modpacks & Mod Browser","launcher_feature_modpacks_desc":"Build your own modpacks and browse mods from CurseForge, Modrinth and more","launcher_feature_skins_title":"Skin Library","launcher_feature_skins_desc":"Browse and apply skins directly from the launcher","launcher_feature_instances_title":"Instances","launcher_feature_instances_desc":"Create and manage multiple instances for different setups","launcher_feature_modloaders_title":"LabyMod, Forge, Fabric & More","launcher_feature_modloaders_desc":"Launch LabyMod, vanilla Minecraft, Forge, Fabric and other modloaders from a single launcher","launcher_feature_import_title":"One-Click Import","launcher_feature_import_desc":"Import instances from other launchers with a single click","launcher_cta_text":"Free for Windows, macOS and Linux","launcher_feature_modbrowser_title":"Modpacks & Mod Browser","launcher_feature_modbrowser_desc":"Build your own modpacks and browse mods from CurseForge, Modrinth and more","launcher_feature_accounts_title":"Account Switcher","launcher_feature_accounts_desc":"Switch between multiple Minecraft accounts instantly without restarting the launcher","addons_badge":"Addon Store","addons_title_1":"300+ Mods.","addons_title_2":"All included.","addons_description":"Extend your Minecraft with community and official addons.","addons_more_hint":"+300 more addons in the integrated store","addons_discover_all":"Discover all","addon_better_perspective_desc":"360° camera control without disturbing shadows. Perfect for content creators and PvP players.","addon_damage_indicator_desc":"Show damage dealt in real time. Visualize every hit with floating numbers.","addon_item_physics_desc":"Realistic physics for dropped items. Items fall, roll and stack naturally.","addon_keystrokes_desc":"Show your key inputs on screen. Perfect for streams and Let\'s Plays.","addon_freelook_desc":"Look around freely without changing movement direction. Essential for competitive gameplay.","addon_toggle_sneak_desc":"Toggle sneaking on and off with one key press. Save your fingers while building.","features_badge":"Features","features_title_1":"Hundreds of features.","features_title_2":"Unlimited possibilities.","features_description":"From gameplay improvements to visual customizations. LabyMod offers everything you need to enhance your Minecraft experience, all just one click away.","features_hover_hint":"Hover over a feature for details.","features_loading":"Loading features...","features_more":"and much more","features_uncategorized":"More Features","features_count":"%count% Features","cosmetics_badge":"Cosmetics & Emotes","cosmetics_title_1":"Show who you are.","cosmetics_title_2":"With unique cosmetics.","cosmetics_description":"Every cosmetic is created with attention to detail by our designers. Highest quality, unique designs, perfect animations and <span class=\'text-white font-semibold\'>fully customizable</span>.","cosmetics_try_it_out":"Try it out!","cosmetics_highlight_handcrafted":"Handcrafted with attention to detail","cosmetics_highlight_customizable":"Colors & textures customizable","cosmetics_highlight_quality":"Highest quality standards","cosmetics_customize":"Customize","cosmetics_discover_shop":"Discover shop","serverlist_badge":"Rich Server List","serverlist_title_1":"Server list?","serverlist_title_2":"Revolutionized.","serverlist_description":"Forget pixelated icons and boring lists. Experience your servers with HD graphics, live data and smart features.","serverlist_hd_title":"HD Server Icons & Backgrounds","serverlist_hd_desc":"High-resolution graphics instead of pixelated 64x64 icons. Every server with its own background image.","serverlist_quickjoin_title":"Quick Join","serverlist_quickjoin_desc":"Jump directly into game modes like BedWars, SkyWars or SkyBlock with one click.","serverlist_dragdrop_title":"Drag & Drop Organisation","serverlist_dragdrop_desc":"Drag servers onto each other to create folders. Organize everything to your liking.","serverlist_players_title":"Live Player Counts","serverlist_players_desc":"Real-time updates always show you current player counts and server status.","design_fancy":"Fancy","design_vanilla":"Vanilla","design_pause":"Pause","design_play":"Play","design_replay":"Replay","settings_performance":"Performance","settings_flux":"Flux","settings_motion_blur":"Motion Blur","settings_fov_changer":"FOV Changer","settings_fullbright":"Fullbright","settings_widgets":"LabyMod Widgets","settings_fancy_font":"Fancy Font","settings_advanced_chat":"Advanced Chat","settings_press_key":"Press key...","settings_set_hotkey":"Set hotkey","ws_manage_world":"Manage World","ws_hosting":"Hosting","ws_not_hosting":"Not Hosting","ws_tab_settings":"Settings","ws_tab_players":"Players","ws_tab_invite":"Invite","ws_game_settings":"Game Settings","ws_game_mode":"Game Mode","ws_difficulty":"Difficulty","ws_allow_cheats":"Allow Cheats","ws_hosting_settings":"Hosting Settings","ws_privacy":"Privacy","ws_max_players":"Max Players","ws_port":"Port","ws_stopping":"Stopping...","ws_stop_hosting":"Stop Hosting","ws_host_world":"Host World","ws_connected_players":"Connected Players (%current%/%max%)","ws_no_players":"No players connected","ws_kick":"Kick","ws_kick_all":"Kick All Players","ws_friends_available":"Friends (%count% available)","ws_slots":"%current%/%max% slots","ws_joined":"Joined","ws_offline":"Offline","ws_full":"Full","ws_invite":"Invite","ws_start_hosting_first":"Start hosting first","ws_max_reached":"Max players (%count%) reached","ws_mode_survival":"Survival","ws_mode_creative":"Creative","ws_mode_adventure":"Adventure","ws_mode_spectator":"Spectator","ws_diff_peaceful":"Peaceful","ws_diff_easy":"Easy","ws_diff_normal":"Normal","ws_diff_hard":"Hard","ws_privacy_public":"Public","ws_privacy_friends":"Friends Only","ws_privacy_invite":"Invite Only","seo_heading_1":"Everything you need to know about","seo_heading_2":"Minecraft clients","seo_intro_1":"Vanilla Minecraft ships with a bare-bones client. No keystroke overlay, no CPS counter, no armour and durability HUD, and your FPS and coordinates are buried in the debug screen. LabyMod adds all of that as a HUD you can arrange yourself, plus its own launcher, a cosmetics system and voice chat.","seo_intro_2":"LabyMod 4 is a free Minecraft client for the Java Edition. It bundles over 100 mods into a single installation, runs on Windows, macOS and Linux, and supports more than 20 Minecraft versions from 1.8.9 up to the latest release. There is nothing to set up before your first launch. Install it, pick a version, play.","faq_heading":"Frequently asked questions","faq_subheading":"The questions we get asked most about LabyMod and about Minecraft clients in general.","faq_q_what_is":"What is a Minecraft client?","faq_a_what_is":"It is the software that runs the game on your computer and talks to the server you play on. A modded client has quality-of-life features built in that vanilla Minecraft lacks: an FPS display, a coordinates HUD, keystrokes, better chat and a customisable interface. You still need the game and an account. A client changes how you play, not what you play.","faq_q_free":"Is LabyMod free?","faq_a_free":"Yes. LabyMod 4 and the Laby Launcher cost nothing, and every mod, the voice chat, the server list and the launcher are included. Development is funded through optional purchases in the [[shop|shop]]: cosmetics, and [[plus|Laby+]], a one-time premium membership with no subscription or auto-renewal. Neither is needed to use the client.","faq_q_download":"How do I install LabyMod?","faq_a_download":"Download the installer for Windows, macOS or Linux from this page and run it. It sets up the Laby Launcher, a standalone program you start Minecraft from instead of the official launcher. Pick a version there and you are in the game. If you get stuck, our [[support|support pages]] cover the usual cases.","faq_q_versions":"Which Minecraft versions are supported?","faq_a_versions":"More than 20 versions of Minecraft Java Edition, from the classic PvP version 1.8.9 through to the current release. You switch between them in the launcher without reinstalling, and each version keeps its own mods and settings. New Minecraft releases are usually supported within days, and every update is listed in the [[changelog|changelog]].","faq_q_premium":"Do I need a paid Minecraft account?","faq_a_premium":"Yes. LabyMod requires a genuine Minecraft Java Edition account from Microsoft. It is not a cracked client and cannot be used to play without owning the game.","faq_q_hacked":"Is LabyMod a hacked client?","faq_a_hacked":"No. There are no cheats in LabyMod: no killaura, no X-ray, no reach. It is built to be allowed on servers, which is why large networks support it directly and can identify it as a legitimate client. Every feature is one you could use in a ranked game without gaining an unfair advantage.","faq_q_mobile":"Does it work on mobile or Bedrock Edition?","faq_a_mobile":"LabyMod is built for Minecraft Java Edition on desktop. There is no official Android, iOS or Bedrock version of the client itself. There is a [[app|LabyMod mobile app]], though: it lets you customise your cosmetics, collect daily rewards and spend LabyCoins in the shop from your phone.","faq_q_mods":"Can I use Forge, Fabric and OptiFine mods?","faq_a_mods":"Yes. The Laby Launcher starts LabyMod, vanilla Minecraft, Forge and Fabric from one place, and you can browse and install mods from CurseForge and Modrinth inside it. You can also build your own modpacks and import instances from other launchers with a single click.","faq_q_performance":"Will LabyMod improve my FPS?","faq_a_performance":"For most players, yes. Performance mods and rendering optimisations are enabled by default, and on older hardware the difference over vanilla is usually noticeable. How much you gain depends on your machine, your Minecraft version and your video settings. It is an optimisation, not a guarantee.","faq_q_cosmetics":"What are cosmetics, capes and skins?","faq_a_cosmetics":"Cosmetics are visual items your character wears in-game: [[cloaks|cloaks]], bandanas, hats, wings and emotes, visible to everyone else running LabyMod. Skins are separate from that. We host a large library of [[skins|Minecraft skins]] and [[capes|capes]] that you can browse on laby.net and apply directly in the launcher or in the client.","seo_lead":"A Minecraft client is the program you actually play the game with. A modded client replaces the default one with a version that has the useful tools built in.","seo_fact_price":"Free forever","seo_fact_price_detail":"The client and launcher cost nothing","seo_fact_versions":"20+ versions","seo_fact_versions_detail":"From 1.8.9 to the latest release","seo_fact_platforms":"3 platforms","seo_fact_platforms_detail":"Windows, macOS and Linux"},"launcher":{"meta_title":"Laby Launcher - The Free Minecraft Launcher","meta_description":"Start Minecraft in seconds. Switch accounts instantly, run any version, launch Forge and Fabric, build modpacks and browse skins, all in one launcher.","meta_keywords":"Laby Launcher, LabyMod Launcher, Minecraft launcher, free Minecraft launcher, Minecraft instances, modpacks, CurseForge, Modrinth, Forge, Fabric, NeoForge, Minecraft skins","hero_title_1":"One launcher for","hero_title_2":"all your Minecraft.","hero_subtitle":"Instances for every setup, any version, every major modloader. Free on Windows, macOS and Linux.","hero_more_downloads":"All platforms & downloads","hero_screenshot_alt":"Laby Launcher home screen with skin preview, friends list and Quick Play bar","tour_title":"Built around your setups","tour_subtitle":"Everything lives in the launcher, so you spend less time in menus and more time in the game.","tour_instances_tab":"Instances","tour_instances_title":"A clean instance for every setup","tour_instances_desc":"Keep versions, modloaders and mods neatly separated. Duplicate an instance before you experiment, sort them into groups, and import setups from other launchers or a .mrpack file in one click.","tour_instances_alt":"Instance overview in the Laby Launcher","tour_mods_tab":"Mods & Modpacks","tour_mods_title":"CurseForge and Modrinth built in","tour_mods_desc":"Browse, install and update mods without leaving the launcher. Incompatible mods are flagged before they break your game, and updating a whole instance takes one click.","tour_mods_alt":"Mod browser with Modrinth and CurseForge in the Laby Launcher","tour_skins_tab":"Skins & Cosmetics","tour_skins_title":"Your skin library, one click away","tour_skins_desc":"Collect skins, preview them live and apply them before you launch. Capes and LabyMod cosmetics are managed in the same place.","tour_skins_alt":"Skin library in the Laby Launcher","loaders_title":"Launches more than LabyMod","loaders_subtitle":"Pick any Minecraft version from the earliest releases to the latest snapshot and pair it with the modloader you need.","loaders_platforms_note":"Mods and modpacks come straight from CurseForge and Modrinth.","bento_title":"The details are the feature","bento_quickplay_title":"Quick Play","bento_quickplay_desc":"Jump straight onto your favorite server from the home screen, no menus in between.","bento_accounts_title":"Account switching","bento_accounts_desc":"Switch between Minecraft accounts instantly, without logging in again.","bento_java_title":"Java, handled","bento_java_desc":"The launcher installs and picks the right Java runtime for every Minecraft version.","bento_updates_title":"Always up to date","bento_updates_desc":"The launcher updates itself quietly on all three platforms.","bento_recovery_title":"Crash recovery","bento_recovery_desc":"Searchable logs and automatic recovery when a game refuses to start.","bento_languages_title":"Speaks your language","bento_languages_desc":"Fully localized into 30 languages.","download_title":"Get the Laby Launcher","download_subtitle":"Free for Windows, macOS and Linux, and about a minute from your first launch.","download_windows_desc":"Windows 10 or newer","download_macos_desc":"Apple Silicon & Intel","download_linux_desc":"AppImage, deb, rpm & Flathub"},"spotify":{"meta_title":"Spotify Discovery - Music from Minecraft","meta_description":"See what the Minecraft community listens to while playing. Discover tracks and artists shared by players who connected Spotify to their Laby profile.","discovery_title":"Spotify Discovery","discovery_subtitle":"Find users who share your music taste","discovery_breadcrumb":"Discovery","similar_taste_title":"Users With Similar Taste","similar_taste_subtitle":"Based on your top Spotify artists","shared_artists":"shared artists","shared_artists_count":"%value% artists","shared_tracks_count":"%value% songs","no_similar_users":"No similar users found. Make sure Spotify is connected and visible in your","settings_link":"settings","browse_by_genre":"Browse by Genre","all_genres":"All","search_artists":"Search artists...","popular_artists":"Popular Artists in the Community","load_more":"Load More","no_artists_search":"No artists found matching your search.","no_artists_genre":"No artists found for this genre.","how_it_works_title":"How does this work?","how_it_works_description":"When Laby users connect their Spotify account, their top artists are synced. This page shows the most popular artists among all Laby users and helps you discover users who share your music taste. Connect your Spotify in","how_it_works_suffix":"to appear here and find your music soulmates!","listeners":"listeners","artist_not_found":"Artist not found","return_home":"Return to home","popularity":"Popularity","users_listening":"Users listening to this artist","loading_more_users":"Loading more users...","no_users_artist":"No users have this artist in their top artists yet.","top_listeners_title":"Top Listeners","top_listeners_subtitle":"Users with the most tracks by this artist in their top 50","matching_tracks":"%value% songs in their top 50","top_tracks_title":"Top Tracks of Our Users","top_tracks_subtitle":"The most loved songs across the Laby community","track_listeners":"%value% listeners","by_artists":"by"},"legal":{"privacy_title":"Privacy Policy","privacy_description":"Privacy policy of LabyMedia GmbH in accordance with GDPR","terms_title":"Terms and Conditions","terms_description":"Terms and conditions of LabyMedia GmbH","imprint_title":"Legal Notice","imprint_description":"Legal information and imprint of LabyMedia GmbH"},"valentine":{"login":"Please log in to continue"},"account":{"setup_required":"Please set up your email and password to continue.","setup_required_title":"Account Setup Required","setup_required_checkout":"To complete your purchase, you need to set up an email address and password for your account.","setup_account_button":"Set Up Account","title":"Account","subtitle":"Manage your security, communication and connected apps","tabs":{"apps":"Apps"}},"tools":{"title":"Minecraft Tools","description":"Free tools, generators and calculators for Minecraft - right in your browser","meta_title":"Minecraft Tools - Generators & Calculators","meta_description":"Free Minecraft tools in your browser: banner and firework designers, colour codes, enchantment and potion calculators, skin editor and much more.","categories":{"generators":"Generators","calculators":"Calculators","reference":"Guides & Reference"},"color_codes":{"title":"Color Codes","subtitle":"All Minecraft color and formatting codes at a glance - click any code to copy it, or style your own text with a live preview.","card_description":"Minecraft color & formatting codes with live text preview","meta_title":"Minecraft Color Codes & Formatting Codes - Minecraft Tool","meta_description":"Complete list of all Minecraft color codes (§ and &) and formatting codes with hex values, shadow colors and a live text generator with Minecraft-style preview.","colors_title":"Chat colors","colors_hint":"Click a color to copy its § code, or select the codes below it by hand - configs (Bukkit/Spigot, EssentialsX) use & instead of §.","click_to_copy":"Click to copy","shadow_label":"Shadow","formats_title":"Formatting codes","generator_title":"Text generator","generator_hint":"Select text and style it with the toolbar - typed § codes are converted as you write. Switch to the code view to edit the raw § codes directly.","generator_placeholder":"Type your text with § codes…","editor_placeholder":"Type your text here…","editor_visual":"Visual","editor_code":"Code","insert_colors":"Colors","insert_formats":"Formatting","format_bold":"Bold","format_italic":"Italic","format_underline":"Underline","format_strikethrough":"Strikethrough","format_obfuscated":"Obfuscated","format_reset":"Reset","preview_label":"Preview","output_section_sign":"Text with § codes (in-game, signs, plugins)","output_ampersand":"Text with & codes (Bukkit/Spigot configs, EssentialsX)","meta_keywords":"minecraft color codes, minecraft formatting codes, § codes, minecraft chat colors, color code list, minecraft hex colors, ampersand color codes, motd color codes","seo_intro":"Every Minecraft color and formatting code in one place: the classic 16 § colors with their names, hex values and shadow colors, the formatting codes for bold, italic, underline, strikethrough and obfuscated text - plus a live generator that styles your own text and copies it with § or & prefixes for chat plugins, signs, MOTDs and books.","seo_features_title":"The complete color code reference","seo_feature_1_title":"All 16 colors with hex values","seo_feature_1_text":"From §0 black to §f white - each with its official name, foreground hex value and the matching text shadow color.","seo_feature_2_title":"Formatting codes included","seo_feature_2_text":"Bold §l, italic §o, underline §n, strikethrough §m, obfuscated §k and reset §r - with live examples of each.","seo_feature_3_title":"Click to copy","seo_feature_3_text":"Every code copies with one click - as § code, & code or raw hex value, whatever your target supports.","seo_feature_4_title":"Live text styler","seo_feature_4_text":"Type your own text, apply colors and formats and see it rendered in the authentic Minecraft font.","seo_feature_5_title":"Plugin-friendly output","seo_feature_5_text":"Copy styled text with the & prefix for Bukkit/Spigot/Paper configs or with § for vanilla contexts.","seo_feature_6_title":"Bedrock compatible","seo_feature_6_text":"The classic codes work across Java and Bedrock - including Bedrock\'s extra material colors where they exist.","seo_howto_title":"How to use Minecraft color codes","seo_howto_1_title":"Find your color","seo_howto_1_text":"Browse the table with all 16 colors and 6 formatting codes, each shown exactly as it renders in-game.","seo_howto_2_title":"Copy the code","seo_howto_2_text":"Click to copy §b, &b or the hex value - depending on whether you target vanilla, a plugin or a custom format.","seo_howto_3_title":"Style full texts","seo_howto_3_text":"Or write your text in the generator, style it visually and copy the complete coded string.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How do I type the § symbol?","seo_faq_1_a":"On most keyboards it\'s not directly available in Minecraft chat. Copy texts with § from this page, or use & codes on servers with chat plugins that translate them. On signs and in books, § can be pasted from the clipboard in Java Edition.","seo_faq_2_q":"What\'s the difference between § and & codes?","seo_faq_2_a":"Vanilla Minecraft only understands §. The & prefix is a plugin convention (Bukkit/Spigot/Paper) that gets translated to § server-side - handy because & is easy to type.","seo_faq_3_q":"Can I use custom hex colors in chat?","seo_faq_3_a":"Java 1.16+ supports 24-bit colors via JSON text components (/tellraw) and the §x legacy format on many servers. For gradients across text, use our Gradient Generator.","seo_faq_4_q":"Why does my color reset after a formatting code?","seo_faq_4_a":"Using a color code resets active formatting, so the order matters: set the color first, then the format - for example §6§l for bold gold. §r resets everything.","seo_faq_5_q":"Do color codes work in the MOTD?","seo_faq_5_a":"Yes, but server.properties needs the escaped form \\\\u00A7 instead of the raw § character - our MOTD Generator produces that automatically.","seo_faq_6_q":"What is the obfuscated §k format?","seo_faq_6_a":"§k renders characters as rapidly changing random glyphs - the classic \'magic text\'. It keeps the original text length, and everything after it stays scrambled until a reset."},"gradient":{"title":"Gradient Generator","subtitle":"Turn any text into a smooth color gradient and copy it as MiniMessage, &-hex or §x codes for chat, signs and plugins - with a live Minecraft-style preview.","card_description":"Spread a smooth color gradient across any text with copy-ready codes","meta_title":"Minecraft Gradient Generator - Color Fade Text for Chat & Plugins","meta_description":"Create smooth Minecraft color gradients for any text and copy them as MiniMessage, &-hex or §x codes, with a live Minecraft-style preview.","text_title":"Your text","text_placeholder":"Type the text you want to color…","colors_title":"Gradient colors","colors_hint":"Add up to seven color stops. The gradient is spread evenly across every character of your text.","pick_color":"Pick a color","add_color":"Add color","remove_color":"Remove color","format_title":"Formatting","format_bold":"Bold","format_italic":"Italic","format_underline":"Underline","format_strikethrough":"Strikethrough","format_obfuscated":"Magic","preview_label":"Preview","preview_empty":"Type some text to see the gradient.","output_title":"Output","output_minimessage":"MiniMessage (Adventure, Paper, most modern plugins)","output_ampersand":"&-hex per character (EssentialsX, most chat plugins)","output_section":"§x hex per character (in-game, signs, books)","meta_keywords":"minecraft gradient generator, color gradient text, minimessage gradient, hex color codes minecraft, fade text generator, rgb text minecraft, gradient nickname","seo_intro":"Turn any text into a smooth color gradient and copy it in the format your platform understands: MiniMessage tags for Paper and Adventure plugins, &#RRGGBB hex codes for BungeeCord-style chats, or the legacy §x sequence for older setups. The preview renders your gradient in the authentic Minecraft font as you type.","seo_features_title":"Smooth gradients for every platform","seo_feature_1_title":"Multi-stop gradients","seo_feature_1_text":"Blend between two or more colors with freely placeable stops - the interpolation stays smooth per character.","seo_feature_2_title":"Three output formats","seo_feature_2_text":"Copy as MiniMessage <gradient> tag, &#-hex codes or the legacy §x§R§R§G§G§B§B sequence, whatever your server expects.","seo_feature_3_title":"Live Minecraft preview","seo_feature_3_text":"See the gradient rendered in the Minecraft font while you type - including bold, italic and other formats.","seo_feature_4_title":"Formatting support","seo_feature_4_text":"Combine the gradient with bold, italic, underline or strikethrough - the codes are woven in correctly per character.","seo_feature_5_title":"Preset palettes","seo_feature_5_text":"Start from curated color pairs - sunset, ocean, rainbow and more - and fine-tune the stops afterwards.","seo_feature_6_title":"Character-exact output","seo_feature_6_text":"Each character gets its precise interpolated color, with spaces skipped so no codes are wasted.","seo_howto_title":"How to create gradient text","seo_howto_1_title":"Type your text","seo_howto_1_text":"Enter the name, title or message the gradient should run across.","seo_howto_2_title":"Pick the colors","seo_howto_2_text":"Choose start and end colors - or add more stops for multi-color fades - and watch the live preview.","seo_howto_3_title":"Copy your format","seo_howto_3_text":"Copy MiniMessage, &-hex or §x output and paste it into your plugin config, chat or sign.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"Which format do I need for my server?","seo_faq_1_a":"Paper/Velocity plugins using Adventure understand MiniMessage (<gradient:#ff0000:#0000ff>). Many Spigot/Bukkit plugins parse &#RRGGBB. Vanilla-adjacent or older setups need the legacy §x sequence. When in doubt, check your plugin\'s docs - this tool outputs all three.","seo_faq_2_q":"Since when does Minecraft support hex colors?","seo_faq_2_a":"Java 1.16 added 24-bit RGB colors to text components. Legacy chat formats emulate them with the §x code followed by six § hex digit codes - that\'s the sequence this generator produces for you.","seo_faq_3_q":"Why is my gradient text so long?","seo_faq_3_a":"Legacy formats need up to 14 characters of codes per visible character, that\'s inherent to §x. MiniMessage is dramatically shorter because one tag covers the whole text - prefer it wherever supported.","seo_faq_4_q":"Can I use gradients in the MOTD?","seo_faq_4_a":"Yes - most modern server software accepts §x hex codes in the MOTD. Generate the gradient here, then paste it into our MOTD generator or your server config with escaped § characters.","seo_faq_5_q":"Do gradients work on signs and in books?","seo_faq_5_a":"With commands, yes: JSON text components support per-character colors. Purely in the vanilla sign editor you can\'t enter hex codes - use the generated /give or /data output paths instead.","seo_faq_6_q":"Can I combine a gradient with bold or italic?","seo_faq_6_a":"Yes - enable the format toggles and the generator repeats the formatting codes correctly after every color change, which is the part that usually goes wrong when doing it by hand."},"motd":{"title":"MOTD Generator","subtitle":"Design your server\'s message of the day with color codes and see exactly how it will look in the multiplayer server list.","card_description":"Create a server MOTD with colors and live server-list preview","meta_title":"Minecraft MOTD Generator - Server List Message Creator","meta_description":"Create a colorful MOTD for your Minecraft server with § color codes, a live server-list preview and a ready-to-paste server.properties string.","editor_title":"MOTD editor","line1_label":"Line 1","line2_label":"Line 2","too_long":"A line is longer than 45 visible characters and may be cut off in the server list.","editor_placeholder":"Type your MOTD here - two lines at most…","preview_title":"Server list preview","server_name_label":"Server name","output_title":"Output","output_raw_label":"Raw MOTD (§ codes, \\\\n as line break)","output_properties_label":"server.properties (unicode-escaped, paste as the motd line)","properties_hint":"server.properties only accepts ASCII, so the § character has to be written as the \\\\u00A7 unicode escape.","meta_keywords":"minecraft motd generator, server motd creator, motd color codes, server.properties motd, minecraft server list message, custom motd, motd unicode symbols","seo_intro":"The MOTD is your server\'s first impression: two lines in the multiplayer server list that decide whether players click join. This generator styles both lines with all color and formatting codes, shows a pixel-accurate server-list preview with your icon, and outputs the escaped string ready to paste into server.properties.","seo_features_title":"Design a server list entry that stands out","seo_feature_1_title":"Authentic server-list preview","seo_feature_1_text":"Your MOTD renders exactly like in the multiplayer screen - Minecraft font, icon, ping bar and player count included.","seo_feature_2_title":"All colors and formats","seo_feature_2_text":"The 16 classic colors plus bold, italic, underline, strikethrough and obfuscated - freely mixed within each line.","seo_feature_3_title":"Two-line layout control","seo_feature_3_text":"Edit both MOTD lines separately and keep an eye on the width limit so nothing gets cut off in the list.","seo_feature_4_title":"server.properties output","seo_feature_4_text":"Copy the finished MOTD with § escaped as \\\\u00A7 - paste it straight into server.properties without breaking encoding.","seo_feature_5_title":"Symbols and unicode","seo_feature_5_text":"Spice up the MOTD with arrows, stars and other unicode symbols that render in the Minecraft font.","seo_feature_6_title":"Centering helper","seo_feature_6_text":"Center lines automatically with the right amount of padding - the classic MOTD look, without counting pixels.","seo_howto_title":"How to set a custom MOTD","seo_howto_1_title":"Style both lines","seo_howto_1_text":"Write your two MOTD lines and apply colors and formatting - the server-list preview updates live.","seo_howto_2_title":"Copy the escaped string","seo_howto_2_text":"Copy the generated motd= value with escaped color codes (\\\\u00A7).","seo_howto_3_title":"Paste into server.properties","seo_howto_3_text":"Replace the motd line in server.properties and restart or reload the server - done.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How long can a MOTD be?","seo_faq_1_a":"The server list shows two lines of roughly 45-50 characters each, depending on character widths. Longer lines are cut off - the preview shows you exactly where.","seo_faq_2_q":"Why do my color codes not work in server.properties?","seo_faq_2_a":"The file is read with ISO-8859-1 encoding, so a raw § often breaks. Use the escaped form \\\\u00A7b instead of §b - this generator outputs exactly that.","seo_faq_3_q":"Can I use line breaks in the MOTD?","seo_faq_3_a":"Yes - the second line is separated with \\\\n in server.properties. The generator manages both lines separately and inserts the escape for you.","seo_faq_4_q":"Do hex colors work in the MOTD?","seo_faq_4_a":"Vanilla servers only render the 16 classic colors in the MOTD. Some proxies and plugins (BungeeCord, Velocity, ServerListPlus) support full RGB - check your setup\'s documentation.","seo_faq_5_q":"How do I add a server icon?","seo_faq_5_a":"Place a 64x64 PNG named server-icon.png in the server\'s root folder and restart. The preview here shows how icon and MOTD look together.","seo_faq_6_q":"Does the MOTD affect the server ping?","seo_faq_6_a":"No - the MOTD is part of the status response the client requests anyway. Fancy formatting has zero performance impact."},"coordinates":{"title":"Coordinate Calculator","subtitle":"Convert coordinates between the Overworld and the Nether, measure distances and look up chunk & region info","card_description":"Convert Nether & Overworld coordinates and measure distances","meta_title":"Minecraft Coordinate Calculator - Nether Portal & Distance Tool","meta_description":"Convert Minecraft coordinates between the Overworld and the Nether, calculate 2D and 3D distances between two points and look up chunk and region file coordinates.","portal_title":"Nether ⇄ Overworld","overworld":"Overworld","nether":"Nether","swap":"Swap","teleport_command":"Teleport command","nether_hint":"1 block in the Nether equals 8 blocks in the Overworld (X and Z). Y is not scaled.","distance_title":"Distance Calculator","point_a":"Point A","point_b":"Point B","distance_3d":"3D distance","distance_2d":"2D distance (X/Z)","blocks":"blocks","chunk_title":"Chunk & Region Info","block_position":"Block position","chunk_coords":"Chunk","pos_in_chunk":"Position in chunk","region_coords":"Region","region_file":"Region file","chunk_hint":"A chunk is 16×16 blocks; a region file stores 32×32 chunks (512×512 blocks).","meta_keywords":"minecraft coordinate calculator, nether portal calculator, overworld to nether coordinates, minecraft distance calculator, chunk calculator, region file finder, nether portal linking","seo_intro":"Convert coordinates between the Overworld and the Nether at the exact 8:1 ratio, measure 2D and 3D distances between two points and look up which chunk and region file any position belongs to. Essential for linking Nether portals precisely, planning Nether highways and debugging chunk-related issues.","seo_features_title":"All coordinate math in one tool","seo_feature_1_title":"Nether ↔ Overworld conversion","seo_feature_1_text":"X and Z divide by 8 into the Nether and multiply by 8 back - the tool converts both directions instantly, Y stays untouched.","seo_feature_2_title":"Portal linking helper","seo_feature_2_text":"See exactly where to build the matching portal so both sides link to each other instead of spawning stray portals.","seo_feature_3_title":"2D and 3D distance","seo_feature_3_text":"Measure the straight-line distance between two points - horizontally (ignoring height) and in full 3D.","seo_feature_4_title":"Chunk lookup","seo_feature_4_text":"Every position resolves to its chunk coordinates and the block\'s position inside the 16x16 chunk.","seo_feature_5_title":"Region file finder","seo_feature_5_text":"Find the r.X.Z.mca region file that contains a coordinate - invaluable for world editing and backup surgery.","seo_feature_6_title":"F3-friendly input","seo_feature_6_text":"Paste coordinates straight from the F3 debug screen; the tool parses full X/Y/Z triples for you.","seo_howto_title":"How to link two Nether portals","seo_howto_1_title":"Read the Overworld position","seo_howto_1_text":"Stand at your Overworld portal and note X, Y and Z from the F3 screen (or the Bedrock coordinates display).","seo_howto_2_title":"Convert to Nether coordinates","seo_howto_2_text":"Enter the position - the tool divides X and Z by 8 and gives you the target point in the Nether.","seo_howto_3_title":"Build the portal there","seo_howto_3_text":"Travel to those Nether coordinates (a similar Y helps) and build the portal - both portals now link reliably.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How do Nether coordinates work?","seo_faq_1_a":"One block traveled in the Nether equals eight blocks in the Overworld: X and Z are divided by 8 going in and multiplied by 8 coming out. The Y coordinate is not scaled.","seo_faq_2_q":"Why does my portal lead to the wrong place?","seo_faq_2_a":"Minecraft searches for an existing portal within 16 blocks (Nether: 128 blocks in Overworld terms) of the ideal exit. If your portals aren\'t at matching converted coordinates, a different portal wins - build the second portal at the calculated position to fix the link.","seo_faq_3_q":"What is a chunk and why does it matter?","seo_faq_3_a":"A chunk is a 16x16 block column the world is stored and loaded in. Chunk borders matter for farms, spawn mechanics and performance - the calculator shows the chunk for any coordinate (block X and Z divided by 16, rounded down).","seo_faq_4_q":"Which region file contains my base?","seo_faq_4_a":"Regions bundle 32x32 chunks into one r.X.Z.mca file. The tool computes the file name from any coordinate, so you can back up or restore exactly the right file.","seo_faq_5_q":"How far is 1 Nether block of travel worth?","seo_faq_5_a":"Eight Overworld blocks. An ice-boat Nether highway effectively multiplies your travel speed by 8, which is why long-distance connections are almost always built through the Nether.","seo_faq_6_q":"Does the 8:1 rule apply to Bedrock too?","seo_faq_6_a":"Yes - both editions use the same 8:1 X/Z scaling, so the calculated portal positions work in Java and Bedrock alike."},"xp":{"title":"XP Calculator","subtitle":"Convert between experience levels and points, plan level-ups and look up common XP sources","card_description":"Convert between experience levels and points","meta_title":"Minecraft XP Calculator - Levels, Points & Bottles","meta_description":"Convert Minecraft experience levels to XP points and back, calculate the XP needed between two levels including Bottles o\' Enchanting, and browse common XP sources.","converter_title":"Level ⇄ Points","level_to_points":"Level → Points","points_to_level":"Points → Level","level":"Level","points":"XP points","total_points":"Total XP points","resulting_level":"Level","progress_to_next":"Progress to next level","set_level_command":"Set level command","add_points_command":"Add points command","range_title":"From Level to Level","from_level":"From level","to_level":"To level","points_needed":"XP points needed","bottles_needed":"Bottles o\' Enchanting","bottles_hint":"A Bottle o\' Enchanting drops 3–11 XP points (7 on average).","sources_title":"Common XP Sources","source":"Source","xp_amount":"XP","src_hostile":"Most hostile mobs (zombie, skeleton, creeper …)","src_baby":"Baby zombies","src_blaze_guardian":"Blaze, Guardian & Evoker","src_ravager":"Ravager","src_wither":"Wither","src_dragon_first":"Ender Dragon (first time)","src_dragon_again":"Ender Dragon (respawned)","src_passive":"Passive mobs (cow, pig, sheep …)","src_breeding":"Breeding animals","src_fishing":"Fishing","src_trading":"Trading with villagers","src_bottle":"Bottle o\' Enchanting","src_smelt_ore":"Smelting iron / gold ore (per item)","src_smelt_food":"Cooking food (per item)","src_mining_coal":"Mining coal ore","src_mining_diamond":"Mining diamond / emerald ore","src_mining_lapis":"Mining lapis / nether quartz ore","src_spawner":"Breaking a mob spawner","meta_keywords":"minecraft xp calculator, experience levels to points, xp for level 30, bottle o enchanting, xp farm calculator, experience command minecraft, level cost","seo_intro":"Convert experience levels into points and back with Minecraft\'s exact non-linear formulas, calculate the XP needed between any two levels - including how many Bottles o\' Enchanting that is - and check common XP sources. Indispensable for planning enchanting sessions, XP farms and /xp commands.","seo_features_title":"Experience math, solved","seo_feature_1_title":"Levels ↔ points conversion","seo_feature_1_text":"The exact vanilla formulas across all three level brackets - no lookup tables, no approximations.","seo_feature_2_title":"Level-to-level planning","seo_feature_2_text":"Compute the exact XP between any two levels - like 27 to 30 for that next big enchant.","seo_feature_3_title":"Bottles o\' Enchanting","seo_feature_3_text":"See how many XP bottles a target amount equals, using their average yield per throw.","seo_feature_4_title":"XP source reference","seo_feature_4_text":"Typical experience values of mobs, smelting, breeding, fishing and mining at a glance.","seo_feature_5_title":"/xp command output","seo_feature_5_text":"Copy give commands for levels or points to grant exactly the calculated amount.","seo_feature_6_title":"Enchanting cost aware","seo_feature_6_text":"Understand what level 30 really costs and why staying at level 30+ makes enchanting cheaper.","seo_howto_title":"How to calculate your XP","seo_howto_1_title":"Enter levels or points","seo_howto_1_text":"Type a level, a point amount or a level range - the calculator converts in every direction.","seo_howto_2_title":"Read the breakdown","seo_howto_2_text":"See total points, the difference to your target and the equivalent in XP bottles.","seo_howto_3_title":"Plan your farm session","seo_howto_3_text":"Use the source reference to estimate how many mobs, furnaces or fish get you there.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How much XP is level 30?","seo_faq_1_a":"Reaching level 30 from zero takes 1,395 experience points. Level 50 takes 5,345 and level 100 already 30,970 - the cost curve is steeply non-linear.","seo_faq_2_q":"Why do higher levels cost so much more?","seo_faq_2_a":"Minecraft uses three formulas: through level 16 each level costs 2n+7 points, up to 31 it\'s 5n-38, beyond that 9n-158. The per-level cost therefore keeps climbing - level 39 to 40 alone costs 193 points.","seo_faq_3_q":"How much XP does a Bottle o\' Enchanting give?","seo_faq_3_a":"Each thrown bottle yields 3-11 points, 7 on average. The calculator uses that average to translate any XP amount into bottle counts for shop pricing or quick top-ups.","seo_faq_4_q":"Do I lose all XP on death?","seo_faq_4_a":"You drop a small portion (up to 7 levels\' worth as orbs) and lose the rest. On servers, keepInventory or plugins may change this - vanilla hardcore planning should assume the loss.","seo_faq_5_q":"What are the fastest XP sources?","seo_faq_5_a":"Enderman and guardian farms top the list, followed by classic mob farms, furnace arrays (smelting), breeding and fishing. The reference table shows typical per-action values to compare.","seo_faq_6_q":"How does enchanting consume levels?","seo_faq_6_a":"The enchanting table takes 1-3 lapis and 1-3 levels but requires up to level 30 to show the best enchants - staying above 30 and re-enchanting repeatedly is the efficient pattern. Anvil operations consume the displayed level cost entirely."},"time":{"title":"Tick Converter","subtitle":"Convert between game ticks, real time and the Minecraft clock - with a live day/night cycle","card_description":"Convert between real time, Minecraft time and game ticks","meta_title":"Minecraft Tick Converter - Game Ticks, Real Time & Clock","meta_description":"Convert between Minecraft game ticks, real time and the in-game clock, visualize the day/night cycle and copy ready-to-use /time set commands.","converter_title":"Time Converter","game_ticks":"Game ticks","ticks":"Ticks","real_time":"Real time","hours":"h","minutes":"min","seconds":"s","clock_time":"Minecraft clock","clock_hour":"Hour","clock_minute":"Minute","conversion_hint":"20 ticks = 1 second · 24,000 ticks = 1 Minecraft day = 20 real minutes","day_cycle_title":"Day/Night Cycle","phase_day":"Day","phase_sunset":"Sunset","phase_night":"Night","phase_sunrise":"Sunrise","presets_title":"Presets","preset_day":"Day","preset_noon":"Noon","preset_sunset":"Sunset","preset_night":"Night","preset_midnight":"Midnight","preset_sunrise":"Sunrise","time_command":"Time command","reference_title":"Notable Tick Values","col_ticks":"Ticks","col_event":"Event","col_clock":"Clock","col_real":"Real time","ref_day_start":"Start of day (06:00)","ref_day":"Day (/time set day)","ref_noon":"Noon (sun at its peak)","ref_sunset":"Sunset begins","ref_bed":"Beds become usable (clear weather)","ref_night":"Night (monsters spawn)","ref_midnight":"Midnight (moon at its peak)","ref_sunrise":"Sunrise begins","ref_next_day":"Next day starts","meta_keywords":"minecraft tick converter, game ticks to seconds, minecraft time calculator, minecraft day length, time set command, redstone tick, minecraft clock converter","seo_intro":"Convert between game ticks, real-world time and the in-game clock in both directions - with a visual day/night cycle showing where any tick value lands. A Minecraft day is 24,000 ticks or exactly 20 real minutes; this converter does the math for command timings, redstone contraptions, farm rates and /time set values.","seo_features_title":"Every Minecraft time unit, converted","seo_feature_1_title":"Ticks ↔ real time","seo_feature_1_text":"20 ticks per second: convert any tick count into hours, minutes and seconds - and back.","seo_feature_2_title":"In-game clock conversion","seo_feature_2_text":"Translate day time ticks into the Minecraft clock (6:00 at tick 0) and pick times of day visually.","seo_feature_3_title":"Day/night cycle view","seo_feature_3_text":"See sunrise, noon, sunset, night and the monster-spawn window on a live cycle visualization.","seo_feature_4_title":"/time set commands","seo_feature_4_text":"Copy ready commands for day, noon, night, midnight or any exact tick value.","seo_feature_5_title":"Redstone-friendly","seo_feature_5_text":"Convert repeater delays and observer pulses: 1 redstone tick = 2 game ticks = 0.1 seconds.","seo_feature_6_title":"Duration presets","seo_feature_6_text":"Common reference points built in - day length, night length, potion durations and more.","seo_howto_title":"How to convert Minecraft time","seo_howto_1_title":"Enter any value","seo_howto_1_text":"Type ticks, real time or a clock time - the other units update instantly.","seo_howto_2_title":"Read the cycle","seo_howto_2_text":"Check where the value falls in the day/night cycle - sleep window, mob spawning, beds and phantoms.","seo_howto_3_title":"Copy the command","seo_howto_3_text":"Grab the matching /time set command for your world or command block chain.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How long is a Minecraft day?","seo_faq_1_a":"A full day/night cycle is 24,000 game ticks = 20 real minutes. Daytime lasts 10 minutes, sunset/sunrise about 1.5 minutes each, and the night roughly 7 minutes.","seo_faq_2_q":"How many ticks are in a second?","seo_faq_2_a":"The game runs at 20 ticks per second, so one tick is 50 milliseconds. Redstone components tick at half that rate: a redstone tick equals 2 game ticks (0.1 s).","seo_faq_3_q":"What do /time set day, noon and night equal?","seo_faq_3_a":"day = 1000, noon = 6000, night = 13000, midnight = 18000 ticks. Tick 0 corresponds to 6:00 in the morning on the in-game clock.","seo_faq_4_q":"When can players sleep and when do mobs spawn?","seo_faq_4_a":"Beds work from tick 12542 (12010 during rain), and hostile mobs spawn on the surface at light levels the night brings from around tick 13000. The cycle view marks both windows.","seo_faq_5_q":"Does /time add skip weather or daylight only?","seo_faq_5_a":"/time add advances the world time, which drives the clock and daylight - weather runs on its own timer and is controlled separately with /weather.","seo_faq_6_q":"Why do my farm rates use ticks?","seo_faq_6_a":"Random ticks, spawn attempts and machine cycles are all defined in game ticks, so per-hour rates are just tick math: one hour equals 72,000 game ticks."},"banner":{"title":"Banner Designer","subtitle":"Design a custom Minecraft banner with up to six pattern layers and copy the matching give command for banner and shield.","card_description":"Layer patterns and colors into a custom banner with give command","meta_title":"Minecraft Banner Designer - Custom Banner & Shield Generator","meta_description":"Design custom Minecraft banners and shields online. Layer up to six patterns, pick dye colors, preview the result and copy the /give command for Java 1.21.","preview":"Preview","randomize":"Randomize","clear":"Clear","base_color":"Base color","layers":"Layers","layers_hint":"Up to 6 pattern layers, drawn bottom to top","no_layers":"No pattern layers yet. Add a layer or hit randomize to get started.","add_layer":"Add layer","move_up":"Move up","move_down":"Move down","remove_layer":"Remove layer","pattern_and_color":"Pattern & color","layer_color":"Layer color","pattern":"Pattern","select_layer":"Add and select a layer to change its pattern and color.","commands":"Give commands","banner_command":"Banner","shield_command":"Shield","syntax_hint":"Java Edition 1.20.5+ component syntax (works in 1.21).","drag_reorder":"Drag to reorder","presets_title":"Presets","preset_names":{"creeper":"Creeper","pirate":"Pirate","ender_eye":"Ender Eye","thing":"Thing","snout":"Snout","germany":"Germany","nordic":"Nordic","union":"Union","sunset":"Sunset","bullseye":"Bullseye","flower":"Flower","france":"France","ukraine":"Ukraine","bee":"Bee","fire":"Fire","diamond":"Diamond"},"meta_keywords":"minecraft banner designer, banner generator, custom banner minecraft, banner patterns, shield designer, banner give command, minecraft flag maker, banner letters","seo_intro":"Design custom Minecraft banners the way the game actually layers them: a base color plus up to six pattern layers, each in one of 16 dye colors. The live preview shows the exact in-game rendering, and one click copies the /give command for the banner - or for a shield carrying the same design.","seo_features_title":"A full banner workshop in your browser","seo_feature_1_title":"All vanilla patterns","seo_feature_1_text":"Every banner pattern from stripes and gradients to creeper face, skull charge and the ominous banner motifs.","seo_feature_2_title":"Six pattern layers","seo_feature_2_text":"Stack up to six layers exactly like a loom does and reorder or recolor any layer at any time.","seo_feature_3_title":"Banner and shield output","seo_feature_3_text":"Copy the /give command for the banner itself or for a shield with the same design applied.","seo_feature_4_title":"Pixel-accurate preview","seo_feature_4_text":"The preview uses the real banner textures and layer blending, so what you see is what spawns in-game.","seo_feature_5_title":"Loom recipe view","seo_feature_5_text":"See which dyes and pattern items you need at the loom to craft the banner in survival mode.","seo_feature_6_title":"Modern command syntax","seo_feature_6_text":"Commands use the banner_patterns item component for Java 1.20.5+, ready for chat or command blocks.","seo_howto_title":"How to design a custom banner","seo_howto_1_title":"Pick the base color","seo_howto_1_text":"Choose one of the 16 wool colors as the banner background.","seo_howto_2_title":"Layer patterns","seo_howto_2_text":"Add up to six patterns, each with its own dye color - the order decides what covers what, just like at a loom.","seo_howto_3_title":"Copy the give command","seo_howto_3_text":"Copy the /give command for banner or shield, or follow the loom recipe to craft it in survival.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How many patterns can a banner have?","seo_faq_1_a":"In survival a loom applies up to six pattern layers. With commands you could add more, but the designer sticks to six so every design stays craftable in-game.","seo_faq_2_q":"How do I put a banner design on a shield?","seo_faq_2_a":"In Java Edition you combine a banner and a shield in a crafting grid - or simply copy the shield variant of the /give command from this tool.","seo_faq_3_q":"Which patterns need a special banner pattern item?","seo_faq_3_a":"Creeper charge, skull charge, flower charge, thing (Mojang logo), globe, snout, flow and guster each require their banner pattern item at the loom; everything else just needs dye.","seo_faq_4_q":"Can I write letters on banners?","seo_faq_4_a":"There are no letter patterns in vanilla Minecraft, but many letters can be approximated by stacking stripes, crosses and borders - the six-layer preview makes experimenting easy.","seo_faq_5_q":"Do the commands work in Bedrock Edition?","seo_faq_5_a":"The generated syntax targets Java Edition. In Bedrock, banners use a different command format, but the design and loom recipe transfer one to one.","seo_faq_6_q":"How do I copy a banner in-game?","seo_faq_6_a":"Craft a blank banner with the same base color and combine it with your finished banner in the crafting grid - you get two identical banners without repeating the loom steps."},"firework":{"title":"Firework Generator","subtitle":"Design custom firework rockets with explosion shapes, colors, trails and twinkle - and copy the /give command.","card_description":"Design firework rockets with effects, colors and give command","meta_title":"Minecraft Firework Generator - Custom Rocket /give Command","meta_description":"Design custom Minecraft firework rockets: explosion shapes, dye colors, fade colors, trail and twinkle effects.","rocket_settings":"Rocket Settings","flight_duration":"Flight duration","flight_duration_help":"Craftable rockets use 1–3 gunpowder. Higher values fly longer before exploding.","rocket_count":"Rocket count","syntax":"Command syntax","syntax_modern":"1.20.5+","syntax_legacy":"1.13 – 1.20.4","preview":"Preview","preview_hint":"Decorative preview of shapes and palettes - not physically accurate.","explosions":"Explosions","explosion":"Explosion","add_explosion":"Add explosion","duplicate":"Duplicate","remove":"Remove","shape":"Shape","shape_small_ball":"Small Ball","shape_large_ball":"Large Ball","shape_star":"Star","shape_creeper":"Creeper","shape_burst":"Burst","trail":"Trail (diamond)","twinkle":"Twinkle (glowstone)","primary_colors":"Primary colors","colors_hint":"The 16 firework star dye colors - the command stores their exact RGB values.","fade_colors":"Fade colors","fade_colors_hint":"Optional - the sparks fade to these colors after the explosion.","command":"Give command","command_hint":"Run this in chat or a command block. A crafted rocket holds up to 7 firework stars.","meta_keywords":"minecraft firework generator, firework rocket command, custom fireworks minecraft, firework star colors, firework give command, elytra firework, firework show minecraft","seo_intro":"Design firework rockets exactly like crafting them from firework stars - just without wasting gunpowder on experiments. Pick explosion shapes, primary and fade colors, trail and twinkle effects and the flight duration, watch the rocket explode in a live preview and copy the /give command for Java Edition.","seo_features_title":"Fireworks engineering made visual","seo_feature_1_title":"All explosion shapes","seo_feature_1_text":"Small ball, large ball, star, creeper face and burst - combine multiple explosion stars in a single rocket.","seo_feature_2_title":"Colors and fade colors","seo_feature_2_text":"Choose any dye colors per explosion plus separate fade colors the sparks transition into.","seo_feature_3_title":"Trail and twinkle","seo_feature_3_text":"Add the diamond trail and glowstone twinkle effects per star, exactly like the crafting recipe modifiers.","seo_feature_4_title":"Flight duration control","seo_feature_4_text":"Set gunpowder count (1-3) for launch height - or craft-impossible values for command-only rockets.","seo_feature_5_title":"Live explosion preview","seo_feature_5_text":"Watch the finished rocket launch and explode with your colors before you spawn a single one in-game.","seo_feature_6_title":"Elytra-ready output","seo_feature_6_text":"Generate stacks of boost rockets without stars, or show rockets for displays - both as clean /give commands.","seo_howto_title":"How to create a custom firework rocket","seo_howto_1_title":"Design the explosion","seo_howto_1_text":"Pick shape, colors, fade colors and effects for the first star - and add more stars for layered explosions.","seo_howto_2_title":"Set the flight","seo_howto_2_text":"Choose flight duration 1-3 for the launch height, matching one to three gunpowder in the recipe.","seo_howto_3_title":"Copy and launch","seo_howto_3_text":"Copy the /give command, grab the rockets in-game and launch them from the ground, a dispenser or a crossbow.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How do firework colors work?","seo_faq_1_a":"Each firework star carries one or more dye colors for the explosion and optional fade colors the particles shift into. In crafting you add dyes to the star; the generator writes them straight into the item\'s NBT/components.","seo_faq_2_q":"What do trail and twinkle do?","seo_faq_2_a":"Trail (crafted with a diamond) leaves particle trails behind every spark; twinkle (glowstone dust) makes sparks flash and crackle after the explosion. Both can be combined on the same star.","seo_faq_3_q":"How high does a rocket fly?","seo_faq_3_a":"Flight duration 1-3 (one to three gunpowder) roughly corresponds to 8-20, 18-34 and 32-52 blocks. Commands also allow values outside that range, including instant explosions at duration 0.","seo_faq_4_q":"Do custom rockets work with elytra?","seo_faq_4_a":"Yes - any rocket boosts elytra flight. But rockets containing explosion stars damage you on use, so pure boost rockets without stars are the safe choice for travel.","seo_faq_5_q":"Can one rocket have multiple explosions?","seo_faq_5_a":"Yes - a rocket accepts up to seven firework stars in crafting, each with its own shape and colors. The generator lets you stack them and previews the combined explosion.","seo_faq_6_q":"How do I launch fireworks automatically?","seo_faq_6_a":"Put the generated rockets into a dispenser facing up and clock it with redstone - the standard setup for synchronized firework shows."},"skin_editor":{"title":"Skin Editor","studio_title":"Skin Studio","background_light":"Light background","background_dark":"Dark background","subtitle":"Paint directly on a 3D Minecraft skin - pixel by pixel, right in your browser.","card_description":"Paint Minecraft skins directly on a 3D model and export them as PNG","meta_title":"Minecraft Skin Editor & Maker - Create Skins in 3D","meta_description":"Free Minecraft skin editor in your browser. Paint straight onto the 3D model with layers, symmetry and filters, then download a 64x64 PNG.","tool_pencil":"Pencil","tool_noise":"Auto tone","tool_bucket":"Fill bucket","tool_eraser":"Eraser","tool_color_picker":"Color picker","undo":"Undo","redo":"Redo","upload":"Upload skin","download":"Download skin","reset":"Start fresh","reset_hint":"Replace the current skin with the default template","reset_confirm":"Confirm reset?","model_classic":"Classic","model_slim":"Slim","model_title":"Model","overlay":"Overlay","reset_zoom":"Fit","mix_hint_compact":"Tap a part to apply it","touch_paint":"Paint with one finger","touch_orbit":"Rotate with one finger","touch_hint":"1 finger paints · 2 fingers rotate & zoom","color":"Color","save_short":"Save","dismiss":"Dismiss","walk_mode_needs_3d":"Walk mode needs the 3D view","noise_strength":"Auto tone strength","bucket_mode_connected":"Connected","bucket_mode_replace":"Same color","bucket_mode_face":"Face","bucket_mode_part":"Body part","studio_open":"Open Skin Studio","studio_open_hint":"Use the editor as a fullscreen app","studio_exit":"Exit fullscreen","studio_exit_hint":"Back to the page view","pixel_grid":"Pixel grid on hover","walk_mode":"Walk mode","walk_mode_hint":"Take a walk as your skin - WASD to move, Esc to exit","walk_mode_hud":"WASD move · Space jump · F5 camera · Esc exit","reset_view":"Reset view","view_3d":"3D","view_2d":"2D","view_split":"Split","primary_color":"Primary color","secondary_color":"Secondary color","primary_color_hint":"Primary color (left click)","secondary_color_hint":"Secondary color (right click)","swap_colors":"Swap colors","pick_from_screen":"Pick from screen","recent_colors":"Recently used","loading":"Preparing the editor…","load_failed":"Could not load this skin.","upload_success":"Skin loaded into the editor.","upload_invalid_size":"Skins must be 64×64 (or legacy 64×32) pixels.","download_success":"Skin downloaded!","download_failed":"Export failed.","webgl_failed_title":"3D view unavailable","webgl_failed_description":"Your browser or device does not support WebGL, which the skin editor needs to render the 3D model.","hint_drag":"Drag","hint_paint":"paint / rotate around the model","hint_right_click":"Right click","hint_secondary":"paint with secondary color","hint_pan":"pan the camera","hint_double_click":"Double click","hint_focus":"focus a body part","edit_in_editor":"Edit this skin in the Skin Editor","library_title":"Skins","library_subtitle":"Pick a skin, then drag its body parts onto your model","library_search":"Search skins or tags (e.g. Marvel)…","library_results":"Search results","library_yours":"Library","library_recent":"Recent","library_recent_empty":"No skins on your account yet.","library_trending":"Trending","library_no_results":"No skins found.","library_no_results_hint":"Try another name or tag.","library_empty_title":"Your library is empty","library_empty_hint":"Save skins to your library from any skin page, or search below to grab body parts from any skin.","library_guest_title":"Mix & match skins","library_guest_hint":"Search for any skin and drag its body parts onto your model.","tryon_tab":"Shop","tryon_sheet_title":"Try on cosmetics","tryon_intro":"Try shop cosmetics on your skin while you edit - tap an item to put it on.","tryon_wearing":"Trying on","tryon_clear":"Take off all","tryon_remove":"Take off","tryon_view_in_shop":"View in shop","tryon_customize":"Customize","tryon_search":"Search cosmetics…","tryon_all":"All","tryon_empty":"No cosmetics found.","tryon_empty_hint":"Try another name or category.","tryon_shop_link":"Discover more in the shop","tryon_failed":"Could not load this cosmetic.","mix_title":"Mix & Match","mix_hint":"Click a body part to swap it into your model","mix_source":"Source skin","mix_source_unnamed":"Unnamed skin","mix_clear":"Clear","mix_applied":"%part% replaced","mix_replaced":"Replaced","part_head":"Head","part_torso":"Torso","part_right_arm":"Right arm","part_left_arm":"Left arm","part_right_leg":"Right leg","part_left_leg":"Left leg","menu_load":"Load skin","menu_load_hint":"Replace your current skin","menu_mix":"Mix & Match","menu_mix_hint":"Swap in single body parts","library_signin_title":"Sign in for your library","library_signin_hint":"Log in to see the skins you saved on laby.net — or browse Trending and search instead.","library_signin_button":"Sign in","second_layer":"2nd Layer","options_title":"Options","options_expand":"Show options","options_collapse":"Hide options","parts_title":"Body parts","layers_title":"Layers","layer_base":"Base skin","layer_name":"Layer %number%","layer_add":"New layer","layer_delete":"Delete layer","layer_show":"Show layer","layer_hide":"Hide layer","layer_move_up":"Move up","layer_move_down":"Move down","layer_reorder":"Reorder layer","layers_hint":"Painting on the base skin starts a new layer automatically","parts_hint":"Click a part to toggle it","layer_body":"Body","layer_overlay":"Overlay","show_cosmetics":"Show cosmetics","cosmetics_failed":"Could not load your cosmetics.","tool_shape":"Shapes","tool_gradient":"Gradient","tool_shade":"Shading","tool_clone":"Clone stamp","tool_select":"Select","tools_more":"More tools","tools_more_short":"More","brush_size":"Size","brush_size_value":"Brush size %size%","brush_square":"Square tip","brush_round":"Round tip","symmetry":"Symmetry","symmetry_hint":"Strokes mirror onto the opposite side of the model","shape_line":"Line","shape_rect":"Rectangle","shape_ellipse":"Ellipse","shape_fill":"Fill","gradient_hint":"Drag across a face: primary → secondary color","gradient_dither":"Dithering","shade_lighten":"Lighten","shade_darken":"Darken","shade_saturate":"Saturate","shade_desaturate":"Desaturate","shade_hue":"Hue shift","shade_strength":"Shading strength","clone_hint":"Alt+click sets the clone source","clone_ready":"Source set - paint to clone","select_rect":"Rectangle","select_lasso":"Lasso","select_wand":"Magic wand","deselect":"Deselect","filters_title":"Filters","filters_hint":"Recolor the whole skin - grayscale, tint, brightness & more","filter_tint":"Colorize","filter_grayscale":"Grayscale","filter_brightness":"Brightness","filter_contrast":"Contrast","filter_saturation":"Saturation","filter_hue":"Hue shift","filter_invert":"Invert","filter_posterize":"Posterize","filter_outline":"Outline","filter_color":"Color","filter_strength":"Strength","filter_hue_degrees":"Rotation","filter_levels":"Levels","filter_scope":"Apply to","filter_scope_skin":"Whole skin","filter_scope_layer":"Active layer","filter_selection_note":"A selection is active - the filter only affects selected pixels.","filter_apply":"Apply","filter_applied":"Filter applied","filter_empty":"Nothing to apply on this layer.","palette_title":"Skin palette","palette_more":"+%count% more","palette_replacement":"Replacement color","palette_replace":"Replace everywhere","palette_replaced":"Color replaced","layer_rename":"Rename layer","layer_rename_hint":"Double-click to rename","layer_opacity":"Opacity","layer_blend":"Blend mode","blend_normal":"Normal","blend_multiply":"Multiply","blend_screen":"Screen","blend_overlay":"Overlay","blend_darken":"Darken","blend_lighten":"Lighten","blend_soft_light":"Soft light","blend_hue":"Hue","blend_color":"Color","part_tools_title":"Part tools","part_tool_mirror":"Mirror","part_tool_mirror_hint":"Flip the part\'s texture left ↔ right","part_tool_copy":"From opposite","part_tool_copy_hint":"Overwrite with the mirrored texture of the opposite limb","part_tool_rotate":"Rotate 180°","part_tool_rotate_hint":"Rotate every face of the part 180°","part_tool_done":"Body part updated","uv_overlay":"UV layout (2D)","pose_title":"Pose","pose_default":"Standing","pose_walk":"Walking","pose_wave":"Waving","pose_zombie":"Zombie","pose_tpose":"T-Pose","history_title":"History","history_original":"Original","history_step":"Edit","history_skin_load":"Skin loaded","history_part_insert":"Part inserted","export_more":"More export options","export_skin":"Skin PNG (64×64)","export_scaled":"Large PNG (512×512)","export_render":"3D render (PNG)","export_turntable":"Turntable video (WebM)","shortcuts_title":"Keyboard shortcuts","shortcut_tools":"Tools","shortcut_painting":"Painting","shortcut_history":"History","shortcut_view":"View","shortcut_brush_step":"Brush size down / up","shortcut_click":"Click","shortcut_clone_source":"Set clone source","layer_settings":"Layer settings","filter_params":"Settings","tool_options":"Tool options","pixel_grid_static":"Pixel grid","meta_keywords":"minecraft skin editor, skin editor online, create minecraft skin, edit minecraft skin, minecraft skin maker, 3d skin editor, skin creator, custom minecraft skin, alex skin, steve skin, 64x64 skin, free skin editor","seo_intro":"The laby.net Skin Studio is a full Minecraft skin editor that runs right in your browser. Paint pixel by pixel on a live 3D model, work with layers like in a real graphics app, recolor whole skins with filters and export a ready-to-use 64×64 PNG - free, with no download and no account.","seo_features_title":"Everything you need to design Minecraft skins","seo_feature_1_title":"Paint in 3D and 2D","seo_feature_1_text":"Draw directly on the rotating 3D model or switch to the flat 2D texture view - both stay perfectly in sync, down to the hovered pixel.","seo_feature_2_title":"Layers like a graphics app","seo_feature_2_text":"The base skin stays protected while your edits live on layers: reorder, hide, rename, set opacity and blend modes - everything is kept in the share link.","seo_feature_3_title":"Filters & color tools","seo_feature_3_text":"Recolor the whole skin in seconds: grayscale, colorize, brightness, contrast, saturation, hue shift, posterize and outline - plus gradients with dithering.","seo_feature_4_title":"Powerful drawing tools","seo_feature_4_text":"Brush sizes and shapes, a fill bucket with smart modes, auto-tone shading, clone stamp, selections with lasso and magic wand, and a symmetry mode that mirrors your strokes.","seo_feature_5_title":"Mix & match any skin","seo_feature_5_text":"Load any skin from the laby.net library and swap single body parts into your own - the head from one skin, the jacket from another.","seo_feature_6_title":"Save & share instantly","seo_feature_6_text":"Your work is stored in the page link while you paint. Download the finished 64×64 PNG for Minecraft: Java Edition or share the link and continue anywhere.","seo_howto_title":"How to make your own Minecraft skin","seo_howto_1_title":"Start with a skin","seo_howto_1_text":"Begin with Steve or Alex, upload your own skin PNG or pick any skin from the laby.net skin library.","seo_howto_2_title":"Paint and customize","seo_howto_2_text":"Use pencil, fill bucket, filters, layers, symmetry and mix & match on the 3D model or in the 2D view - on desktop and touch devices.","seo_howto_3_title":"Download and use it","seo_howto_3_text":"Export your skin as a 64×64 PNG and upload it in the Minecraft launcher or on minecraft.net - done.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"Is the Minecraft skin editor free?","seo_faq_1_a":"Yes. The editor is completely free, runs in your browser and requires no download, installation or account.","seo_faq_2_q":"How do I use my edited skin in Minecraft?","seo_faq_2_a":"Download your skin as a PNG file and upload it in the Minecraft launcher or in your profile on minecraft.net. The editor produces standard 64×64 skins for Minecraft: Java Edition.","seo_faq_3_q":"Does the editor support Alex (slim) and Steve (classic) models?","seo_faq_3_a":"Yes - you can switch between the classic and the slim model at any time; painting works the same on both.","seo_faq_4_q":"Can I edit an existing skin?","seo_faq_4_a":"Yes. Upload any 64×64 skin PNG, load a skin from the laby.net library, or combine body parts from several skins with mix & match.","seo_faq_5_q":"Will I lose my work when I close the page?","seo_faq_5_a":"No. Your skin - including all layers - is continuously saved into the page URL. Bookmark or share the link to continue exactly where you left off.","seo_faq_6_q":"Does the skin editor work on my phone?","seo_faq_6_a":"Yes. There is a touch-optimized app layout for phones and tablets: one finger paints, two fingers rotate and zoom.","restore_prompt":"Recover your unsaved skin?","restore_action":"Recover","restore_success":"Skin recovered.","seo_h1":"Minecraft Skin Editor"},"tellraw":{"title":"Tellraw & Title","subtitle":"Build colorful /tellraw chat messages and /title screen text with JSON text components - including click and hover events.","card_description":"Build tellraw and title commands with JSON text components","meta_title":"Minecraft Tellraw Generator - /tellraw & /title Command Builder","meta_description":"Build Minecraft /tellraw and /title commands with JSON text components: colors, formatting, click and hover events - with a live chat and title preview for Java.","mode_tellraw":"Chat (tellraw)","mode_title":"Title","mode_subtitle":"Subtitle","mode_actionbar":"Action bar","target_all":"all players","target_nearest":"nearest player","target_self":"yourself","format_modern":"1.21.5+","format_legacy":"1.13 – 1.21.4","format_hint":"Java 1.21.5 renamed clickEvent and hoverEvent to click_event and hover_event with new field names - pick the format matching your server version.","preview":"Preview","subtitle_hint":"A subtitle is only displayed while a title is on screen - send a title command as well.","segments":"Text segments","segment":"Segment","add_segment":"Add segment","move_up":"Move up","move_down":"Move down","remove":"Remove","text":"Text","color":"Color","custom_color":"Custom","style":"Style","style_bold":"Bold","style_italic":"Italic","style_underlined":"Underlined","style_strikethrough":"Strikethrough","style_obfuscated":"Obfuscated","click_event":"Click event","click_none":"None","click_open_url":"Open URL","click_run_command":"Run command","click_suggest_command":"Suggest command","hover_event":"Hover text","hover_placeholder":"Shown on mouse-over (optional)","times":"Title timings","fade_in":"Fade in","stay":"Stay","fade_out":"Fade out","times_hint":"Values in game ticks - 20 ticks = 1 second.","output":"Command","output_times":"Timing command","output_json":"Raw JSON component","meta_keywords":"minecraft tellraw generator, tellraw command, json text generator, title command minecraft, clickable chat message, hover event, minecraft text component generator","seo_intro":"Build /tellraw chat messages and /title screen text visually instead of hand-writing JSON text components. Style segments with colors and formatting, attach click events (run command, open URL, suggest text) and hover tooltips, preview everything in a live chat rendering and copy the finished command for Java Edition.","seo_features_title":"JSON text components without the JSON","seo_feature_1_title":"Segment-based editor","seo_feature_1_text":"Compose messages from segments, each with its own color, formatting and events - exactly how text components work.","seo_feature_2_title":"Click events","seo_feature_2_text":"Make text run a command, suggest chat input, open a URL or copy to clipboard when clicked.","seo_feature_3_title":"Hover tooltips","seo_feature_3_text":"Show styled tooltip text when players hover a segment - the classic interactive-chat building block.","seo_feature_4_title":"Full RGB support","seo_feature_4_text":"Use the 16 classic colors or any 24-bit hex color per segment (Java 1.16+).","seo_feature_5_title":"Title, subtitle and actionbar","seo_feature_5_text":"Switch to /title mode for screen titles with subtitle and actionbar plus fade-in, stay and fade-out timing.","seo_feature_6_title":"Live chat preview","seo_feature_6_text":"See the message exactly as it appears in chat or on screen - including hover previews - before you run anything.","seo_howto_title":"How to build a tellraw message","seo_howto_1_title":"Compose segments","seo_howto_1_text":"Write your text as segments and give each one colors and formatting.","seo_howto_2_title":"Add interactions","seo_howto_2_text":"Attach click actions and hover tooltips where the message should react to players.","seo_howto_3_title":"Copy the command","seo_howto_3_text":"Copy /tellraw or /title and run it in chat or a command block - selector targets like @a included.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"What is /tellraw used for?","seo_faq_1_a":"/tellraw sends raw JSON text components to players - the only way to produce clickable, hoverable, multi-colored chat messages in vanilla. It\'s the backbone of map interfaces, server menus and quest dialogue.","seo_faq_2_q":"What\'s the difference between /tellraw and /title?","seo_faq_2_a":"/tellraw writes into the chat; /title displays large text in the middle of the screen with subtitle and actionbar variants and configurable fade timings. Both use the same text component format, so this generator covers both.","seo_faq_3_q":"Can clicked text run any command?","seo_faq_3_a":"run_command executes one command as the clicking player - with their permissions. Command blocks or functions triggered this way are how servers build clickable menus without plugins.","seo_faq_4_q":"Why does my old tellraw command fail in 1.21.5+?","seo_faq_4_a":"Mojang renamed the event fields: clickEvent became click_event, hoverEvent became hover_event, and hover contents moved. The generator outputs the syntax matching your selected game version.","seo_faq_5_q":"How do I target specific players?","seo_faq_5_a":"Use selectors in the command: @a for everyone, @p for the nearest player, @a[team=red] for a team - or a player name. The message itself can even embed selector components that print player names.","seo_faq_6_q":"Does tellraw work in Bedrock?","seo_faq_6_a":"Bedrock has /tellraw but with a reduced format: no hover events and no click events. Fully interactive messages are a Java Edition feature."},"circle":{"title":"Circle Generator","subtitle":"Generate pixel-perfect circles, ellipses and spheres for your builds","card_description":"Pixel-perfect circles, ellipses and spheres for your builds","meta_title":"Pixel Circle Generator - Minecraft Tool","meta_description":"Generate pixel-perfect circles, ellipses and spheres for your Minecraft builds. Sizes up to 256 blocks, thin, thick or filled outlines and layer-by-layer sphere.","settings":"Settings","mode_circle":"Circle","mode_ellipse":"Ellipse","mode_sphere":"Sphere","width":"Width","height":"Height","style":"Style","style_thin":"Thin outline","style_thick":"Thick outline","style_filled":"Filled","layer":"Layer","grid_numbers":"Grid numbers","hint":"Tip: The thick outline has no diagonal gaps, so you can walk along the wall. The thin outline uses the fewest blocks.","preview":"Preview","zoom_in":"Zoom in","zoom_out":"Zoom out","zoom_fit":"Fit to view","blocks":"Blocks","dimensions":"Dimensions","layer_blocks":"Blocks in this layer","total_blocks":"Total blocks","meta_keywords":"minecraft circle generator, pixel circle generator, minecraft circle chart, block circle, minecraft sphere generator, ellipse generator, circle blueprint minecraft, round building minecraft","seo_intro":"Round shapes are the hardest part of building in a block world. This generator turns any diameter into a pixel-perfect block blueprint: circles, ellipses and full spheres up to 256 blocks, with thin, thick or filled outlines, block counts and a zoomable grid you can follow layer by layer while you build.","seo_features_title":"Blueprints for round builds","seo_feature_1_title":"Circles, ellipses and spheres","seo_feature_1_text":"Generate perfect circles, stretched ellipses with independent width and height, or complete spheres sliced into layers.","seo_feature_2_title":"Up to 256 blocks wide","seo_feature_2_text":"From tiny 3-block rings to monumental 256-block domes - large enough for any survival or creative project.","seo_feature_3_title":"Thin, thick and filled modes","seo_feature_3_text":"Choose classic thin outlines, fully connected thick outlines without diagonal gaps, or filled discs with block counts.","seo_feature_4_title":"Layer-by-layer sphere view","seo_feature_4_text":"Step through every horizontal slice of a sphere and build it layer by layer like a schematic.","seo_feature_5_title":"Exact block counts","seo_feature_5_text":"See how many blocks the shape needs before you gather materials - split by outline and fill.","seo_feature_6_title":"Zoom, pan and grid guides","seo_feature_6_text":"Navigate big blueprints with zoom and center guides, and count comfortably with highlighted axis lines.","seo_howto_title":"How to build a perfect circle in Minecraft","seo_howto_1_title":"Set the size","seo_howto_1_text":"Enter the diameter - or width and height for an ellipse. Odd sizes give you a single center block, even sizes a 2x2 center.","seo_howto_2_title":"Pick the outline style","seo_howto_2_text":"Thin for classic circles, thick for walkable walls without gaps, filled for floors and ceilings.","seo_howto_3_title":"Build along the grid","seo_howto_3_text":"Follow the blueprint quadrant by quadrant - the symmetry means you only really need to count one quarter.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How do I build a circle in Minecraft?","seo_faq_1_a":"Approximate the curve with horizontal and vertical block runs that get shorter toward the diagonals. This generator computes the mathematically best approximation for any diameter so you can just copy the pattern.","seo_faq_2_q":"What\'s the difference between thin and thick outlines?","seo_faq_2_a":"Thin outlines connect blocks diagonally and use the fewest blocks; thick outlines guarantee every block touches the next one orthogonally - important for walls you want to walk on or seal against water.","seo_faq_3_q":"Should I use an odd or even diameter?","seo_faq_3_a":"Odd diameters have a single center block, which makes them ideal around a central feature like a beacon. Even diameters center on a 2x2 area and pair better with even-sized builds.","seo_faq_4_q":"Can I generate spheres and domes?","seo_faq_4_a":"Yes - switch to sphere mode and step through the horizontal layers. For a dome, simply build only the top half of the layers.","seo_faq_5_q":"How many blocks does my circle need?","seo_faq_5_a":"The tool counts outline and fill blocks for every shape and size, so you know exactly how much material to farm before you start.","seo_faq_6_q":"Does this work for other block games?","seo_faq_6_a":"Yes - the blueprints are pure pixel geometry and work in any voxel or grid-based game, from Minecraft to Terraria and beyond."},"armor_dye":{"title":"Armor Dye","subtitle":"Mix dyes and preview leather armor colors exactly like the in-game crafting","card_description":"Mix dyes for leather armor exactly like the in-game crafting","meta_title":"Leather Armor Dye Calculator - Minecraft Tool","meta_description":"Mix Minecraft dyes with the exact in-game leather armor algorithm, preview the color on a full armor set, generate /give commands and find the closest dye recipe.","dye_palette":"Dye palette","palette_hint":"Click a dye to add it to the mix. Dyes can be added multiple times.","current_mix":"Current mix","mix_empty":"No dyes in the mix yet - click a swatch above.","mix_limit_hint":"In game you can combine at most 8 dyes at once - split larger mixes into several dyeing steps.","base_color":"Base color","remove":"Remove","reset":"Reset","use_as_base":"Use result as base","algorithm_note":"Mixing works exactly like in the game: all color channels of the current color and every added dye are summed and averaged, then the result is scaled so its brightest channel matches the average brightness of the inputs.","preview":"Preview","undyed":"Undyed leather","hex":"Hex","decimal":"Decimal","armor_piece":"Armor piece","legacy_syntax":"Legacy syntax (1.20.4 and older)","command":"Give command","piece_helmet":"Leather Cap","piece_chestplate":"Leather Tunic","piece_leggings":"Leather Pants","piece_boots":"Leather Boots","match_title":"Match a color","match_target":"Target color","match_hint":"Pick any color and we search all dye recipes with up to 4 dyes for the closest match.","match_recipe":"Closest recipe","match_result":"Mixed result","match_accuracy":"Match","match_exact":"Exact match","match_use":"Use this recipe","meta_keywords":"minecraft armor dye calculator, dye leather armor, leather armor colors, minecraft dye mixing, dyed armor give command, leather armor hex color, minecraft cauldron dye, armor color generator","seo_intro":"Dyeing leather armor in Minecraft mixes dye colors with an averaging algorithm that is hard to predict by hand. This calculator runs the exact in-game formula: combine up to eight dyes per step, re-dye as often as you like, preview the result on a full armor set and copy the matching /give command - or work backwards and find the dye combination for any target color.","seo_features_title":"Everything for perfectly dyed leather armor","seo_feature_1_title":"Exact in-game algorithm","seo_feature_1_text":"Colors are mixed with the same average-and-rescale formula Minecraft uses when you combine leather armor and dyes in a crafting grid.","seo_feature_2_title":"All 16 dyes, unlimited steps","seo_feature_2_text":"Add up to eight dyes per crafting step and chain as many steps as you want - sequential dyeing unlocks colors a single craft can\'t reach.","seo_feature_3_title":"Reverse color search","seo_feature_3_text":"Pick any target color and the tool finds the dye sequence that gets closest to it, including the remaining color difference.","seo_feature_4_title":"Full armor preview","seo_feature_4_text":"See the result on helmet, chestplate, leggings and boots instantly - exactly how the color renders on leather armor in the game.","seo_feature_5_title":"Ready-to-use /give commands","seo_feature_5_text":"Copy /give commands with the dyed_color component for Java 1.20.5+ or classic NBT for older versions.","seo_feature_6_title":"Hex and RGB support","seo_feature_6_text":"Enter or read exact hex and RGB values at every step - ideal for matching team colors, skins or brand palettes.","seo_howto_title":"How to dye leather armor with a custom color","seo_howto_1_title":"Pick your dyes","seo_howto_1_text":"Select up to eight dyes for the first crafting step, or enter a target hex color and let the reverse search suggest the dyes.","seo_howto_2_title":"Chain crafting steps","seo_howto_2_text":"Add more dyeing steps to fine-tune the shade - the preview always shows the current mixed color on the full armor set.","seo_howto_3_title":"Copy the command","seo_howto_3_text":"Copy the generated /give command or repeat the dye steps in your crafting grid in survival mode.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How does dye mixing work in Minecraft?","seo_faq_1_a":"Minecraft averages the red, green and blue channels of all applied dyes plus the armor\'s current color, then rescales the result so its brightness matches the average maximum channel. This tool reproduces that formula bit for bit.","seo_faq_2_q":"Can I dye armor any hex color?","seo_faq_2_a":"With crafting you can only reach colors that dye combinations can produce - the reverse search finds the closest match. With the /give command any of the 16.7 million RGB colors can be applied directly.","seo_faq_3_q":"Which items can be dyed?","seo_faq_3_a":"Leather helmet, chestplate (tunic), leggings, boots, leather horse armor and wolf armor can be dyed in Java Edition. All of them use the same color mixing rules.","seo_faq_4_q":"How do I remove dye from leather armor?","seo_faq_4_a":"Use a cauldron filled with water: right-click the dyed armor on it to wash the color out and restore the default leather brown.","seo_faq_5_q":"Does the /give command work on servers?","seo_faq_5_a":"Yes, as long as you have operator rights or an equivalent permission. The tool generates the component syntax for Java 1.20.5+ and NBT syntax for older server versions.","seo_faq_6_q":"Why do repeated dyeings shift the color?","seo_faq_6_a":"Every dyeing step averages the armor\'s existing color into the mix, so each pass pulls the result toward the newly added dyes. Sequential steps are the key to shades a single craft cannot reach."},"potions":{"title":"Potion Guide","subtitle":"Every brewable potion in Minecraft Java 1.21 - recipes, durations and give commands","card_description":"Brewing recipes, effects and give commands for every potion","meta_title":"Minecraft Potion Guide & Brewing Recipes - Minecraft Tool","meta_description":"Interactive Minecraft potion brewing guide for Java 1.21: all brewing recipes, effect durations, splash, lingering and tipped arrow variants with copyable /give.","search_placeholder":"Search potions, effects or ingredients...","filter_all":"All","filter_positive":"Positive","filter_negative":"Negative","filter_mixed":"Special","filter_base":"Base","no_results":"No potions match your search.","no_effects":"No effects","badge_extended":"Redstone","badge_amplified":"Level","badge_not_brewable":"Commands only","potion_id":"Potion ID","brewing_chain":"Brewing","not_brewable":"This potion cannot be brewed - it is only available via commands.","water_bottle_note":"Fill a Glass Bottle at a water source - the start of every brewing chain.","also_from":"Also brewable from:","base_note":"Base potions have no effects - they are intermediate brewing steps.","variants":"Variants","variant_base":"Base","variant_extended":"Extended","variant_amplified":"Enhanced","instant":"Instant","commands":"Give commands","syntax_legacy":"Legacy NBT (1.13 - 1.20.4)","cmd_drink":"Potion","cmd_splash":"Splash Potion","cmd_lingering":"Lingering Potion","cmd_arrow":"Tipped Arrows (x8)","duration_note":"Lingering potions apply effects at 1/4 duration, tipped arrows at 1/8 of the drinkable potion.","how_title":"How brewing works","how_intro":"Every recipe starts with Water Bottles in a brewing stand fueled by Blaze Powder. Ingredients are brewed step by step - first Nether Wart, then the effect ingredient, then optional modifiers:","how_fuel":"Fuels the brewing stand - one piece powers 20 brewing operations.","how_nether_wart":"Turns a Water Bottle into an Awkward Potion, the base for almost every effect.","how_redstone":"Extends the potion\'s duration (long variant).","how_glowstone":"Amplifies the effect to level II (strong variant), usually halving the duration.","how_gunpowder":"Converts a potion into a throwable Splash Potion.","how_dragons_breath":"Turns a Splash Potion into a Lingering Potion that leaves an effect cloud.","how_fermented":"Corrupts effects: Swiftness/Leaping become Slowness, Healing/Poison become Harming, Night Vision becomes Invisibility, a Water Bottle becomes Weakness.","how_tipped":"Craft 8 Arrows around a Lingering Potion to get Tipped Arrows with its effect.","meta_keywords":"minecraft potion guide, brewing recipes, potion brewing chart, all potions minecraft, splash potion, lingering potion, tipped arrows, brewing stand guide","seo_intro":"Every brewable potion in Minecraft Java 1.21 as an interactive guide: full brewing paths from nether wart to the finished potion, effect durations for base, extended and amplified variants, splash and lingering versions, tipped arrows - plus /give commands for every single one.","seo_features_title":"Brewing knowledge, fully mapped","seo_feature_1_title":"All potions and variants","seo_feature_1_text":"Every potion with its normal, extended (redstone) and amplified (glowstone) variant, including exact durations and effect levels.","seo_feature_2_title":"Interactive brewing paths","seo_feature_2_text":"Follow the complete chain: water bottle, awkward potion, effect ingredient, modifiers - step by step at the brewing stand.","seo_feature_3_title":"Splash, lingering and arrows","seo_feature_3_text":"Gunpowder for splash, dragon\'s breath for lingering, and the tipped arrow variants crafted from lingering potions.","seo_feature_4_title":"Ingredient overview","seo_feature_4_text":"See which ingredient creates which effect - from sugar and blaze powder to turtle shell and phantom membrane.","seo_feature_5_title":"Give commands included","seo_feature_5_text":"Copy the /give command for any potion, splash, lingering or tipped arrow without touching NBT by hand.","seo_feature_6_title":"Corrupted-recipe hints","seo_feature_6_text":"Learn which potions come from fermented spider eye corruption - like Slowness from Swiftness or Harming from Healing.","seo_howto_title":"How to brew potions","seo_howto_1_title":"Brew the base","seo_howto_1_text":"Fill glass bottles with water and brew nether wart into them at a brewing stand - fueled by blaze powder - to get awkward potions.","seo_howto_2_title":"Add the effect","seo_howto_2_text":"Brew the effect ingredient into the awkward potion - sugar for Swiftness, magma cream for Fire Resistance, and so on.","seo_howto_3_title":"Modify it","seo_howto_3_text":"Extend with redstone, amplify with glowstone, make it splash with gunpowder or lingering with dragon\'s breath.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"Why does brewing always start with nether wart?","seo_faq_1_a":"Nether wart turns water bottles into awkward potions, the neutral base almost all effect ingredients require. The exceptions: fermented spider eye (Weakness) and a few gimmick potions work directly on water bottles.","seo_faq_2_q":"Can a potion be both extended and amplified?","seo_faq_2_a":"No - redstone (duration) and glowstone (potency) overwrite each other. A potion is either extended or level II, never both.","seo_faq_3_q":"How do tipped arrows work?","seo_faq_3_a":"Craft eight arrows around a lingering potion to get eight tipped arrows with that effect. They apply a shortened version of the effect on hit - and yes, Instant Damage arrows are a thing.","seo_faq_4_q":"What\'s the difference between splash and lingering?","seo_faq_4_a":"Splash potions (gunpowder) apply their effect once on impact in a small radius. Lingering potions (dragon\'s breath) leave a cloud that keeps applying the effect for several seconds - ideal for area denial and tipped arrow crafting.","seo_faq_5_q":"Which potions can\'t be brewed?","seo_faq_5_a":"Luck and Decay (Bedrock) have no Java brewing recipe, and effects like Levitation exist only via commands - the guide marks unbrewable effects and still gives you their /give commands.","seo_faq_6_q":"How does the fermented spider eye work?","seo_faq_6_a":"It corrupts potions into their counterpart: Swiftness becomes Slowness, Healing becomes Harming, Night Vision becomes Invisibility, and on a plain water bottle it brews Weakness."},"enchantments":{"title":"Enchantments","subtitle":"Browse every enchantment in Minecraft Java 1.21 and calculate anvil combination costs","card_description":"All enchantments, compatible items and an anvil calculator","meta_title":"Minecraft Enchantment List & Anvil Calculator - Minecraft Tool","meta_description":"All Minecraft Java 1.21 enchantments with max levels, compatible items and incompatibilities, plus an anvil calculator that computes the exact XP cost of combining.","tab_browser":"Enchantment list","tab_anvil":"Anvil calculator","search_placeholder":"Search enchantments...","syntax_legacy":"Legacy NBT (1.13 - 1.20.4)","filter_all":"All","no_results":"No enchantments match your filters.","treasure":"Treasure","curse":"Curse","applies_to":"Applies to:","incompatible_with":"Incompatible with:","book_command":"Enchanted book","item_all":"All enchantable items","item_sword":"Sword","item_axe":"Axe","item_pickaxe":"Pickaxe","item_shovel":"Shovel","item_hoe":"Hoe","item_bow":"Bow","item_crossbow":"Crossbow","item_trident":"Trident","item_mace":"Mace","item_fishing_rod":"Fishing Rod","item_helmet":"Helmet","item_chestplate":"Chestplate","item_leggings":"Leggings","item_boots":"Boots","item_elytra":"Elytra","item_shield":"Shield","target_slot":"Target (left slot)","sacrifice_slot":"Sacrifice (right slot)","book":"Enchanted Book","same_item":"Same item","slot_empty":"No enchantments selected.","remove":"Remove","add_enchantment":"Add enchantment...","prior_uses":"Prior anvil uses","result":"Result","select_hint":"Add enchantments to both slots to calculate the combination.","enchantments_word":"enchantments","conflicts_dropped":"Dropped (incompatible, +1 level each):","ignored_note":"Ignored (not applicable to the target item):","enchant_cost":"Enchantment cost","prior_work":"Prior work penalty","total_cost":"Total cost","cost_levels":"levels","too_expensive":"Too Expensive!","too_expensive_note":"Costs above 39 levels only work in Creative mode.","next_penalty":"Prior work penalty of the result on the next anvil use:","anvil_rules_title":"How anvil costs work","rule_penalty":"Each previous anvil use adds a prior work penalty of 2 to the power of n, minus 1 levels (0, 1, 3, 7, 15, ...).","rule_multiplier":"Every transferred enchantment costs its final level times a rarity multiplier - enchanted books are about half price.","rule_merge":"Two equal levels combine to one level higher (up to the max level); otherwise the higher level wins.","rule_conflict":"Each incompatible enchantment on the sacrifice is dropped and adds a flat 1 level.","rule_limit":"Anything above 39 levels shows \'Too Expensive!\' in Survival mode.","desc_protection":"Reduces most types of damage","desc_fire_protection":"Reduces fire damage and burn time","desc_blast_protection":"Reduces explosion damage and knockback","desc_projectile_protection":"Reduces projectile damage","desc_feather_falling":"Reduces fall damage","desc_respiration":"Extends underwater breathing time","desc_aqua_affinity":"Normal mining speed while underwater","desc_thorns":"Damages attackers on hit","desc_depth_strider":"Faster movement underwater","desc_frost_walker":"Freezes water beneath you into frosted ice","desc_soul_speed":"Faster movement on soul sand and soul soil","desc_swift_sneak":"Faster movement while sneaking","desc_binding_curse":"The item cannot be removed once worn","desc_sharpness":"Increases melee damage","desc_smite":"Extra damage against undead mobs","desc_bane_of_arthropods":"Extra damage and Slowness against arthropods","desc_knockback":"Increases melee knockback","desc_fire_aspect":"Sets targets on fire","desc_looting":"Mobs can drop more loot","desc_sweeping_edge":"Increases sweep attack damage","desc_density":"More smash attack damage per block fallen","desc_breach":"Reduces the effectiveness of the target\'s armor","desc_wind_burst":"Smash attacks launch you back into the air","desc_efficiency":"Faster mining speed","desc_silk_touch":"Blocks drop themselves instead of their usual items","desc_fortune":"Increases block drops like diamonds or seeds","desc_power":"Increases arrow damage","desc_punch":"Increases arrow knockback","desc_flame":"Arrows set targets on fire","desc_infinity":"Shooting does not consume regular arrows","desc_multishot":"Shoots three arrows at once","desc_quick_charge":"Faster crossbow reloading","desc_piercing":"Arrows pass through multiple entities","desc_loyalty":"A thrown trident returns to you","desc_impaling":"Extra damage against aquatic mobs","desc_riptide":"Launches you forward when thrown in water or rain","desc_channeling":"Summons lightning on hit during thunderstorms","desc_luck_of_the_sea":"Better chances for treasure while fishing","desc_lure":"Fish bite faster","desc_unbreaking":"Chance to not consume durability","desc_mending":"Repairs the item with collected XP orbs","desc_vanishing_curse":"The item disappears when you die","meta_keywords":"minecraft enchantment list, all enchantments, anvil calculator, enchantment max level, incompatible enchantments, minecraft enchanting guide, too expensive anvil, enchantment order","seo_intro":"Browse every enchantment in Minecraft Java 1.21 with max levels, target items, incompatibilities and sources - and stop wasting levels at the anvil: the calculator computes the exact XP cost of combining items, including prior work penalties, and finds the cheapest order for your dream gear.","seo_features_title":"Every enchantment, every cost","seo_feature_1_title":"Complete 1.21 database","seo_feature_1_text":"All enchantments with max level, applicable items, treasure/curse status and where to get them.","seo_feature_2_title":"Incompatibility warnings","seo_feature_2_text":"See instantly which enchantments exclude each other - Sharpness vs. Smite, Infinity vs. Mending and every other group.","seo_feature_3_title":"Anvil cost calculator","seo_feature_3_text":"Combine books and items step by step and get the exact level cost of every operation, just like the real anvil.","seo_feature_4_title":"Prior work penalty tracking","seo_feature_4_text":"The hidden penalty that doubles with every anvil use is tracked per item, so you see when gear approaches \'Too Expensive!\'.","seo_feature_5_title":"Cheapest order finder","seo_feature_5_text":"Plan the combination order that reaches your target enchantments for the fewest total levels.","seo_feature_6_title":"Filter and search","seo_feature_6_text":"Filter by item type or search by name to find the right enchantment in seconds.","seo_howto_title":"How to enchant gear without wasting levels","seo_howto_1_title":"Pick your enchantments","seo_howto_1_text":"Select the item and the enchantments it should end up with - conflicts are flagged immediately.","seo_howto_2_title":"Check the anvil plan","seo_howto_2_text":"The calculator shows each combination step with its level cost, including prior work penalties.","seo_howto_3_title":"Combine in the right order","seo_howto_3_text":"Follow the cheapest order in-game - combining books with books first usually saves many levels.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"Why does the anvil say \'Too Expensive!\'?","seo_faq_1_a":"Any operation above 39 levels is rejected in survival. The prior work penalty doubles with every anvil use of an item (1, 2, 4, 8, 16, 32...), so heavily reworked gear hits the cap - plan the combination order to keep penalties low.","seo_faq_2_q":"What is the prior work penalty exactly?","seo_faq_2_a":"Each item remembers how often it was used in an anvil. The penalty added to a combination is 2^n - 1 levels per item, where n is its anvil use count - which is why combining two fresh books is cheap and repairing an old sword is not.","seo_faq_3_q":"Which enchantments are mutually exclusive?","seo_faq_3_a":"The big groups: damage enchantments (Sharpness/Smite/Bane of Arthropods), protections (except Feather Falling), Silk Touch vs. Fortune, Infinity vs. Mending, Loyalty/Channeling vs. Riptide, and Depth Strider vs. Frost Walker.","seo_faq_4_q":"How do I get max-level books?","seo_faq_4_a":"Enchanting table (up to level 30 enchants), fishing, trading with librarians (the most reliable source for specific max-level books) and structure loot. Two identical books of level n combine into level n+1 at the anvil.","seo_faq_5_q":"Does the order of combining matter?","seo_faq_5_a":"Massively. Merging books together first and applying the merged book late keeps the expensive item\'s use count low. The calculator\'s suggested order routinely saves 10+ levels on a full god-gear build.","seo_faq_6_q":"Are treasure enchantments obtainable from the table?","seo_faq_6_a":"No - treasure enchantments like Mending, Frost Walker or Soul Speed never appear on the enchanting table. They come from loot chests, fishing, raids or librarian trades only."},"shared":{"command_too_long":"A bit long for chat (max. 256 chars) - pop it into a command block.","share":"Share","link_copied":"Link copied!"},"player_head":{"title":"Player Heads","subtitle":"Search any player on laby.net and copy the /give command for their head.","card_description":"Get the give command for any player\'s head","meta_title":"Minecraft Player Head Generator - /give Head Command","meta_description":"Get the /give command for any Minecraft player\'s head. Search players on laby.net, preview their head and copy the command for Java Edition 1.20.5+ or legacy versions.","tab_generator":"Player Search","tab_gallery":"Head Gallery","gallery_browse":"Browse heads","gallery_search_placeholder":"Search %total% heads…","gallery_results":"Showing %shown% of %total% heads","gallery_load_more":"Load more","gallery_empty":"No heads match your search.","gallery_error":"Couldn\'t load this category - please try again.","gallery_retry":"Retry","gallery_selected":"Selected head","gallery_select_hint":"Pick a head from the gallery to get its /give command.","gallery_command_hint":"Texture-based heads are static - they keep this exact look forever, independent of any player\'s skin.","gallery_staff_badge":"Staff","gallery_add_title":"Add head","gallery_add_open":"Add a head to the gallery","gallery_add_texture":"Texture hash, textures.minecraft.net URL or base64 value","gallery_add_name":"Name","gallery_add_category":"Category","gallery_add_tags":"Tags, comma-separated (optional)","gallery_add_submit":"Add to gallery","gallery_add_success":"Head added to the gallery.","gallery_add_duplicate":"This texture is already in the gallery.","gallery_add_failed":"Couldn\'t add the head - is the texture hash correct?","gallery_add_invalid_texture":"Enter a valid texture hash, textures.minecraft.net URL or base64 value.","gallery_remove":"Remove from gallery","gallery_remove_confirm":"Click again to remove","gallery_remove_success":"Head removed from the gallery.","gallery_remove_failed":"Couldn\'t remove the head.","syntax_legacy_texture":"1.16 – 1.20.4","cat_alphabet":"Alphabet","cat_animals":"Animals","cat_blocks":"Blocks","cat_decoration":"Decoration","cat_food_drinks":"Food & Drinks","cat_humanoid":"Humanoid","cat_humans":"Humans","cat_miscellaneous":"Miscellaneous","cat_monsters":"Monsters","cat_plants":"Plants","player_settings":"Player","player_name":"Player name","search_placeholder":"Search laby.net players…","no_results":"No players found - any valid name still works.","invalid_name":"Names are 1–16 letters, digits or underscores.","search_hint":"Pick a player from the laby.net search or just type any valid name.","amount":"Amount","syntax":"Command syntax","syntax_modern":"1.20.5+","syntax_legacy":"1.13 – 1.20.4","preview":"Preview","preview_resolved":"Skin preview from the laby.net player database.","preview_unresolved":"Name not found on laby.net - the command still works.","command":"Give command","command_hint":"The skin is resolved by the server when the command runs - name-based heads keep updating with the player\'s current skin.","survival_title":"Getting heads in survival","survival_commands":"Player heads are command-only in vanilla - no mob, block or trade drops them. That\'s exactly what this generator is for.","survival_creeper":"Mob heads: when a charged creeper\'s explosion kills a creeper, zombie, skeleton or piglin, it drops that mob\'s head - one head per explosion.","survival_wither":"Wither skeletons rarely drop their skull (2.5%, more with Looting), and the dragon head sits on the bow of End ships.","meta_keywords":"minecraft player head generator, give player head command, custom head minecraft, player head give, minecraft skull command, decorative heads, head database","seo_intro":"Get any player\'s head as an in-game item: search a name on laby.net, preview the head in 3D and copy the /give command - with the modern profile component for Java 1.20.5+ or SkullOwner NBT for older versions. Perfect for trophies, decoration, custom models and map making.","seo_features_title":"Any head, one command","seo_feature_1_title":"Search every player","seo_feature_1_text":"Look up any Minecraft account by name via laby.net - including name history awareness and skin preview.","seo_feature_2_title":"3D head preview","seo_feature_2_text":"See the head exactly as it will look placed or worn, rendered from the player\'s current skin.","seo_feature_3_title":"Version-aware commands","seo_feature_3_text":"Copy /give with the profile component (1.20.5+) or classic SkullOwner NBT for older Java versions.","seo_feature_4_title":"Share links","seo_feature_4_text":"The selected player and settings live in the page link - share a head setup or bookmark it for later.","seo_feature_5_title":"Ready for decoration","seo_feature_5_text":"Heads can be placed on blocks, put in item frames, worn as helmets - ideal for shops, trophies and props.","seo_feature_6_title":"Works on servers","seo_feature_6_text":"The give command works in singleplayer and on servers with operator rights - or paste it into a command block.","seo_howto_title":"How to get a player head","seo_howto_1_title":"Search the player","seo_howto_1_text":"Enter the player name - the tool finds the account and loads the current skin.","seo_howto_2_title":"Check the preview","seo_howto_2_text":"Inspect the head in 3D - rendered from the player\'s current skin, exactly as it will look placed or worn.","seo_howto_3_title":"Copy the command","seo_howto_3_text":"Copy the /give command and run it in chat or a command block - the head lands in your inventory.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How do I get a player head in survival?","seo_faq_1_a":"Vanilla survival only drops player heads when a player is killed by a charged creeper\'s explosion. For every other case you need commands - which is exactly what this generator creates.","seo_faq_2_q":"Does the head update when the player changes their skin?","seo_faq_2_a":"Yes - name-based heads are re-resolved by the server, so a given head follows the player\'s current skin over time.","seo_faq_3_q":"Can I wear a player head?","seo_faq_3_a":"Yes - heads go into the helmet slot. On many servers and in map making they double as custom hats and costume pieces.","seo_faq_4_q":"Do the commands work in Bedrock Edition?","seo_faq_4_a":"No - Bedrock has no equivalent give syntax for arbitrary player heads. The generated commands target Java Edition.","seo_faq_5_q":"How do I display heads nicely?","seo_faq_5_a":"Place them on fences, walls or campfires, combine them with item frames, or use armor stands and note blocks - a head on a note block even changes its sound.","seo_faq_6_q":"Is there a head for every skin?","seo_faq_6_a":"Yes - the head item simply renders the head layer (including the hat overlay) of the account\'s skin, so every player automatically has a matching head."},"book":{"title":"Book Editor","subtitle":"Write and style in-game books with § color codes - page by page, with a live book preview and ready-to-copy /give commands.","card_description":"Write in-game books with colors and copy the give command","meta_title":"Minecraft Book Editor - Written Book Generator","meta_description":"Write Minecraft books with colours and formatting. Edit up to 100 pages with paragraph codes, preview the book GUI and copy the /give command.","book_details":"Book details","book_title_label":"Title","title_placeholder":"My Book","book_author_label":"Author","author_placeholder":"Steve","signed_hint":"Title and author only exist on the signed written book - the Book & Quill version stays editable in game.","pages_title":"Pages","add_page":"Add page","duplicate_page":"Duplicate","remove_page":"Remove","pages_word":"pages","page_text_label":"Page text","page_placeholder":"Write your page here - § codes welcome…","page_length_hint":"This page is getting long - in game a page fits about 14 lines (roughly 1023 characters).","preview_title":"Preview","page_word":"Page","of_word":"of","prev_page":"Previous page","next_page":"Next page","commands_title":"Commands","format_modern":"1.20.5+","format_legacy":"1.13 – 1.20.4","output_written":"Written book (signed)","output_writable":"Book & Quill (writable)","writable_newline_hint":"Line breaks in the Book & Quill command need Minecraft 1.21.5+ - older versions display them as a literal \\\\n.","give_hint":"Paste the command into chat or a command block to get the book.","meta_keywords":"minecraft book editor, written book generator, minecraft book give command, book and quill, colored text book, minecraft book formatting, custom book minecraft","seo_intro":"Write in-game books with colors and formatting that survival book-and-quills can\'t produce. The editor gives you up to 100 pages with live § color codes, a pixel-accurate book preview, title and author fields, and /give commands that work in Java 1.20.5+ as well as older versions.","seo_features_title":"Write books like the game renders them","seo_feature_1_title":"Live book preview","seo_feature_1_text":"Text appears in the real book GUI with Minecraft\'s font, line wrapping and page size - no surprises in-game.","seo_feature_2_title":"Full color and formatting","seo_feature_2_text":"Use all 16 § color codes plus bold, italic, underline, strikethrough and obfuscated - mid-sentence and mid-word.","seo_feature_3_title":"Up to 100 pages","seo_feature_3_text":"The in-game maximum: 100 pages with automatic page navigation and per-page character limits.","seo_feature_4_title":"Title, author, generation","seo_feature_4_text":"Set the book\'s title and author and choose the copy generation, exactly like a signed written book.","seo_feature_5_title":"Commands for every version","seo_feature_5_text":"Copy /give with the written_book_content component (1.20.5+) or legacy NBT for older Java versions.","seo_feature_6_title":"Import and continue","seo_feature_6_text":"Paste an existing book command to load its pages back into the editor and keep writing.","seo_howto_title":"How to create a custom written book","seo_howto_1_title":"Write your pages","seo_howto_1_text":"Type your text page by page and place color and formatting codes with the toolbar - the preview updates live.","seo_howto_2_title":"Sign the book","seo_howto_2_text":"Give the book a title and an author name; both show up on the cover and in the item tooltip.","seo_howto_3_title":"Give it in-game","seo_howto_3_text":"Copy the /give command and run it in chat or a command block - the finished, signed book lands in your inventory.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How many pages and characters can a book have?","seo_faq_1_a":"A written book holds up to 100 pages. Each page fits 14 lines of roughly 19 characters; the editor enforces the same limits as the game so commands never get rejected.","seo_faq_2_q":"Can I use colors in a survival book?","seo_faq_2_a":"Not by typing - the book-and-quill GUI has no color input. Colored and formatted books require commands, which is exactly what this editor generates for you.","seo_faq_3_q":"What do the book generations mean?","seo_faq_3_a":"Original, Copy of original, Copy of copy and Tattered indicate how often a book was copied. Copies of copies cannot be copied again in-game.","seo_faq_4_q":"Why is my /give command rejected in chat?","seo_faq_4_a":"Chat has a 256-character limit; long books exceed it quickly. Run long commands from a command block, which allows up to 32,500 characters.","seo_faq_5_q":"Does the editor work for Bedrock Edition?","seo_faq_5_a":"The output targets Java Edition syntax. Bedrock stores books differently and doesn\'t accept these commands, though the text content can of course be reused.","seo_faq_6_q":"Can players copy or edit the book in-game?","seo_faq_6_a":"A signed written book can be read by everyone and copied in a crafting grid with a book-and-quill, but its text can no longer be edited."},"resource_pack":{"title":"Pack Generator","subtitle":"Build a resource pack with a custom totem and custom paintings - everything runs right in your browser.","card_description":"Create custom totem and painting resource packs in your browser","meta_title":"Minecraft Resource Pack Generator - Custom Totem & Paintings","meta_description":"Create a custom Minecraft resource pack in your browser: turn any player skin into a Totem of Undying and replace vanilla paintings with your own images.","tab_totem":"Custom Totem","tab_paintings":"Custom Paintings","search_placeholder":"Search laby.net player…","search_no_results":"No players found","skin_source":"Skin source","skin_source_hint":"Pick any laby.net player or upload a skin PNG - the totem is composed from the skin\'s head, body, arms and legs.","or":"or","upload_skin":"Upload skin PNG","upload_hint":"64×64 pixels, legacy 64×32 skins are converted automatically.","upload_invalid_size":"Skins must be 64×64 (or legacy 64×32) pixels.","load_failed":"Could not load this skin.","no_skin_found":"This player has no skin on record.","cors_blocked":"Your browser blocked reading this skin (CORS). Please upload the skin PNG instead.","totem_preview":"Totem preview","loading":"Loading…","totem_empty":"Pick a player or upload a skin to generate your totem.","totem_from":"Generated from","clear":"Clear","totem_texture_hint":"Replaces the Totem of Undying texture (16×16 pixels).","paintings_title":"Paintings","paintings_hint":"Click a painting slot to upload an image - it is cropped to cover and resized to the painting\'s pixel size.","filter_all":"All sizes","upload_image":"Upload image","replace_image":"Replace image","remove_image":"Remove image","image_load_failed":"Could not read this image.","rights_hint":"Only use images you own or have permission to use.","pack_options":"Pack options & download","pack_name":"Pack name","pack_description":"Description","game_version":"Game version","pack_contents":"Pack contents","content_totem":"Custom totem","content_pack_icon":"Pack icon (totem)","content_painting":"1 custom painting","content_paintings":"custom paintings","content_empty":"Nothing configured yet - add a totem or paintings above.","download":"Download resource pack","building":"Building ZIP…","install_hint":"Drop the ZIP into your resourcepacks folder and enable it in the options.","privacy_hint":"Everything is generated locally in your browser - nothing is uploaded.","meta_keywords":"minecraft resource pack generator, custom totem resource pack, totem of undying skin, custom paintings minecraft, texture pack creator, resource pack maker online","seo_intro":"Build a personal Minecraft resource pack right in your browser - no zip wrangling, no pack.mcmeta editing. Turn any player skin into a custom Totem of Undying and replace the vanilla paintings with your own images; the tool assembles a valid pack for your chosen game version and downloads it ready to drop into the resourcepacks folder.","seo_features_title":"Your pack, assembled in the browser","seo_feature_1_title":"Skin-to-totem converter","seo_feature_1_text":"Enter any player name and the tool builds a Totem of Undying from their skin - a popular personal flex for streamers and servers.","seo_feature_2_title":"Custom paintings","seo_feature_2_text":"Replace any vanilla painting with your own image - each canvas size is cropped and scaled correctly automatically.","seo_feature_3_title":"Correct pack format","seo_feature_3_text":"Choose your Minecraft version and the pack.mcmeta gets the matching pack_format so the pack loads without warnings.","seo_feature_4_title":"Live previews","seo_feature_4_text":"See the totem render and every painting mapped onto its in-game canvas before you download anything.","seo_feature_5_title":"100% client-side","seo_feature_5_text":"Images never leave your browser - the zip is assembled locally and downloads instantly.","seo_feature_6_title":"Vanilla-compatible","seo_feature_6_text":"Pure resource pack output: works in singleplayer and on any server, no mods or OptiFine required.","seo_howto_title":"How to create your resource pack","seo_howto_1_title":"Pick your content","seo_howto_1_text":"Choose a player skin for the totem and/or upload images for the paintings you want to replace.","seo_howto_2_title":"Select the version","seo_howto_2_text":"Set your Minecraft version so the pack format matches - the tool handles pack.mcmeta for you.","seo_howto_3_title":"Download and activate","seo_howto_3_text":"Download the zip into .minecraft/resourcepacks and enable it in Options → Resource Packs.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How do I install a resource pack?","seo_faq_1_a":"Drop the downloaded zip into the resourcepacks folder (reachable via Options → Resource Packs → Open Pack Folder) and activate it in the same menu - no restart needed.","seo_faq_2_q":"Does a custom totem work on servers?","seo_faq_2_a":"Yes - resource packs are purely client-side visuals. You see your custom totem everywhere, other players keep seeing their own textures, and no server permission is needed.","seo_faq_3_q":"Which pack_format do I need?","seo_faq_3_a":"Every Minecraft version expects a specific pack_format number in pack.mcmeta; a mismatch shows the \'made for an older/newer version\' warning. Pick your version in the tool and the right number is written automatically.","seo_faq_4_q":"What image sizes do paintings need?","seo_faq_4_a":"Each painting has a fixed canvas measured in 16-pixel blocks - from 1x1 (16x16 px) up to 4x4 (64x64 px). Your uploads are cropped and scaled to the exact canvas automatically.","seo_faq_5_q":"Can I edit the generated pack afterwards?","seo_faq_5_a":"Yes - the zip has the standard resource pack layout (assets/minecraft/textures/...) and can be extended with any other textures in a text editor and repacked.","seo_faq_6_q":"Are my images uploaded anywhere?","seo_faq_6_a":"No - skins are fetched read-only, your images stay in the browser and the zip is generated locally on your machine."},"display":{"title":"Display Studio","subtitle":"Generate /summon commands for text, block and item display entities - with full transformation control and a live 3D preview.","card_description":"Summon text, block and item displays with a live 3D preview","meta_title":"Display Entity Generator - Minecraft Tool","meta_description":"Create Minecraft /summon commands for text, block and item display entities with rich text, transformations (translation, rotation, scale) and a live 3D preview -.","add_prop":"Add","add_segment":"Add segment","advanced_title":"Interpolation & advanced","align_center":"Center","align_left":"Left","align_right":"Right","alignment":"Alignment","angle_pitch":"Pitch (X)","angle_roll":"Roll (Z)","angle_yaw":"Yaw (Y)","background":"Background","bg_alpha":"Opacity (alpha)","billboard":"Billboard","billboard_center":"Center","billboard_fixed":"Fixed","billboard_hint":"How the entity turns toward the player: not at all, around the vertical or horizontal axis, or both.","billboard_horizontal":"Horizontal","billboard_vertical":"Vertical","block_id":"Block ID","block_props":"Block state properties","block_props_hint":"Optional key=value pairs, e.g. axis=z for logs or lit=true for furnaces.","block_title":"Block","brightness":"Brightness override","brightness_block":"Block light","brightness_sky":"Sky light","custom_color":"Custom","default_background":"Use chat background","format_hint_legacy":"Before 1.21.5 text components are written as JSON strings.","format_hint_modern":"1.21.5+ writes text components as inline SNBT.","format_legacy":"1.19.4 – 1.21.4","format_modern":"1.21.5+","glow_color":"Override glow color","glowing":"Glowing outline","interp_duration":"Interpolation duration","interp_hint":"In game ticks (20 = 1 s): when you later /data merge a new transformation, the display glides to it over the interpolation duration - teleport duration smooths /tp movement the same way.","interp_start":"Start interpolation","item_context":"Display context","item_context_hint":"Which model transform the item uses - like held in a hand, in a GUI slot or lying on the ground.","item_id":"Item ID","item_title":"Item","left_rotation":"Left rotation (degrees)","line_width":"Line width","move_down":"Move down","move_up":"Move up","newline_hint":"Type \\\\n inside a segment for a line break.","opacity_hint":"Values below 26 are not rendered at all - the text turns invisible.","options_title":"Display options","output":"Command","position":"Position (x y z)","preset_billboard":"Giant billboard","preset_hologram":"Hologram label","preset_shop_sign":"Shop sign","preset_spinning_block":"Spinning block","preset_warning":"Glowing warning","presets":"Presets","preview_hint":"Drag to orbit, scroll to zoom. The green cross marks the summon position (~ ~ ~).","preview_title":"3D preview","prop_name":"Property","prop_value":"Value","remove":"Remove","reset":"Reset","reset_view":"Reset view","right_rotation":"Right rotation (degrees)","scale":"Scale","see_through":"Visible through blocks","segments_title":"Text segments","shadow_radius":"Shadow radius","shadow_strength":"Shadow strength","style_bold":"Bold","style_italic":"Italic","style_obfuscated":"Obfuscated","style_strikethrough":"Strikethrough","style_underlined":"Underlined","teleport_duration":"Teleport duration","text_opacity":"Text opacity","text_options":"Text options","text_shadow":"Text shadow","transform_hint":"Applied in Minecraft\'s order: right rotation first, then scale, then left rotation, then translation. Rotations turn around the entity origin - for block displays that is the block\'s corner, not its center.","transformation":"Transformation","translation":"Translation (blocks)","type_block":"Block Display","type_item":"Item Display","type_text":"Text Display","uniform_scale":"Uniform","view_range":"View range","zoom_in":"Zoom in","zoom_out":"Zoom out","auto_spin":"Auto-rotate","format_hint_item":"From 1.20.5 the item stack uses a lowercase count; legacy writes the old Count byte for 1.19.4 - 1.20.4.","meta_keywords":"minecraft display entity generator, text display command, block display, item display, summon display entity, minecraft hologram command, display entity transformation, text display generator","seo_intro":"Display entities are Minecraft\'s modern way to place floating text, blocks and items anywhere in the world - holograms, shop labels, decorative props and animated scenes. This studio builds the /summon commands visually: rich text with colors, full transformation control over translation, rotation and scale, billboard and glow settings, all with a live 3D preview.","seo_features_title":"Text, block and item displays without NBT pain","seo_feature_1_title":"All three display types","seo_feature_1_text":"text_display for holograms and labels, block_display for scaled and rotated blocks, item_display for floating items.","seo_feature_2_title":"Full transformation control","seo_feature_2_text":"Translate, rotate and scale on every axis with sliders - the quaternion math behind display transformations is handled for you.","seo_feature_3_title":"Rich text styling","seo_feature_3_text":"Multi-line text with colors, formatting, background color and opacity, alignment, line width and see-through mode.","seo_feature_4_title":"Billboard and lighting","seo_feature_4_text":"Choose how the display faces the player (fixed, vertical, horizontal, center) and override brightness or add a glow outline.","seo_feature_5_title":"Live 3D preview","seo_feature_5_text":"Every change renders instantly on an interactive 3D scene - no more summon-look-kill-repeat cycles in-game.","seo_feature_6_title":"Clean command output","seo_feature_6_text":"The /summon command contains only non-default NBT, stays readable and works in chat and command blocks (Java 1.19.4+).","seo_howto_title":"How to create a hologram with display entities","seo_howto_1_title":"Choose the display type","seo_howto_1_text":"Pick text, block or item display and set the content - your hologram text, a block state or any item.","seo_howto_2_title":"Transform it","seo_howto_2_text":"Position, rotate and scale the display, choose the billboard mode and style text background and glow.","seo_howto_3_title":"Summon it","seo_howto_3_text":"Copy the /summon command and run it where the display should appear - remove it later with /kill @e[type=text_display].","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"Which Minecraft version supports display entities?","seo_faq_1_a":"Display entities (text_display, block_display, item_display) were added in Java Edition 1.19.4 and are not available in Bedrock. All generated commands target Java 1.19.4 or newer.","seo_faq_2_q":"How do I make floating text without mods?","seo_faq_2_a":"Summon a text_display with your text component - it floats, needs no invisible armor stand tricks, supports full RGB colors, backgrounds and can even face the player automatically via billboard settings.","seo_faq_3_q":"How do I edit an already summoned display?","seo_faq_3_a":"Use /data merge entity on the display (target it with @e[type=text_display,limit=1,sort=nearest]) and change the properties you need - or kill it and summon the corrected version from the studio.","seo_faq_4_q":"Can displays be animated?","seo_faq_4_a":"Yes - displays interpolate transformation changes over a configurable duration. Set a new transformation with start_interpolation and the entity glides smoothly into it, which is how block animations and moving holograms are built.","seo_faq_5_q":"Why is my text display invisible from behind?","seo_faq_5_a":"With billboard \'fixed\' the text has a facing direction. Use billboard \'center\' or \'vertical\' so it rotates toward the player, or place two displays back to back.","seo_faq_6_q":"How do I remove display entities again?","seo_faq_6_a":"Target them by type, e.g. /kill @e[type=text_display,distance=..5]. Displays have no hitbox interaction, so commands are the intended way to manage them."},"armor_stand":{"title":"Armor Stand Generator","subtitle":"Pose an armor stand with sliders, add equipment and flags, and copy the /summon command - with a live 3D preview.","card_description":"Pose armor stands with equipment and copy the /summon command","meta_title":"Armor Stand Generator - Minecraft /summon Command","meta_description":"Pose Minecraft armor stands with sliders, toggle flags like Small, Invisible or Marker, add equipment and copy the /summon command - with a live 3D preview for Java.","presets":"Pose presets","preset_default":"Default","preset_walking":"Walking","preset_running":"Running","preset_pointing":"Pointing","preset_waving":"Waving","preset_sitting":"Sitting","preset_zombie":"Zombie arms","reset_pose":"Reset pose","pose_title":"Pose","pose_hint":"Pose angles are degrees, exactly as written into the Pose NBT. Arm poses only show with the Show arms option.","limb_head":"Head","limb_body":"Body","limb_left_arm":"Left arm","limb_right_arm":"Right arm","limb_left_leg":"Left leg","limb_right_leg":"Right leg","reset":"Reset","rotation":"Rotation (yaw)","position":"Position (x y z)","flags_title":"Options","flag_small":"Small","flag_show_arms":"Show arms","flag_no_base_plate":"No base plate","flag_invisible":"Invisible","flag_marker":"Marker","flag_no_gravity":"No gravity","flag_invulnerable":"Invulnerable","flag_persistence":"Persistence required","flag_glowing":"Glowing","marker_hint":"Marker stands have no hitbox and can\'t be interacted with - remove them with /kill @e[type=armor_stand].","name_title":"Custom name","name_placeholder":"e.g. Guard","name_color_default":"Default color","name_visible":"Always show name","equipment_title":"Equipment","equipment_hint":"Any Java Edition item ID works - the suggestions list the common ones. Leave a slot empty to skip it.","slot_head":"Helmet","slot_chest":"Chestplate","slot_legs":"Leggings","slot_feet":"Boots","slot_main_hand":"Main hand","slot_off_hand":"Off hand","output":"Command","format_hint_legacy":"1.13 - 1.20.4 writes item stacks with the old Count byte.","format_hint_modern":"From 1.20.5 item stacks use a lowercase count int.","format_hint_latest":"1.21.5+ additionally writes the custom name as an inline SNBT component.","preview_title":"3D preview","preview_hint":"Drag to orbit, scroll to zoom. The stand is summoned at the grid center.","zoom_in":"Zoom in","zoom_out":"Zoom out","reset_view":"Reset view","meta_keywords":"minecraft armor stand generator, armor stand poses, summon armor stand command, armor stand pose maker, invisible armor stand, armor stand with arms, minecraft statue generator, armor stand nbt","seo_intro":"Armor stands are the backbone of Minecraft map making and decoration - but posing them by hand means fiddling with raw NBT rotations. This generator lets you pose every limb with sliders on a live 3D preview, equip armor and items, toggle flags like Small, Invisible or Marker, and copy a clean /summon command for Java Edition.","seo_features_title":"Pose, equip and summon armor stands","seo_feature_1_title":"Live 3D posing","seo_feature_1_text":"Rotate head, body, arms and legs with sliders and see the pose on an interactive 3D armor stand in real time.","seo_feature_2_title":"Preset pose library","seo_feature_2_text":"Start from ready-made poses like walking, sitting, blocking or dabbing and fine-tune every joint from there.","seo_feature_3_title":"Full equipment slots","seo_feature_3_text":"Put armor pieces on every slot and items in both hands - including custom player heads on the head slot.","seo_feature_4_title":"All entity flags","seo_feature_4_text":"Toggle Small, Invisible, NoBasePlate, NoGravity, ShowArms and Marker and see the effect immediately.","seo_feature_5_title":"Clean /summon output","seo_feature_5_text":"The generated command only contains the NBT you actually changed - short, readable and ready for command blocks.","seo_feature_6_title":"Shareable configurations","seo_feature_6_text":"Every stand you build is encoded in the page link, so you can share a pose or come back to it later.","seo_howto_title":"How to create a posed armor stand","seo_howto_1_title":"Pose the stand","seo_howto_1_text":"Drag the rotation sliders for each body part or start from a preset pose - the 3D preview updates live.","seo_howto_2_title":"Add equipment and flags","seo_howto_2_text":"Equip armor and hand items, then set flags like ShowArms, Small or Invisible for floating-item displays.","seo_howto_3_title":"Summon it in-game","seo_howto_3_text":"Copy the /summon command and run it in chat or a command block where the stand should appear.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"How do I give an armor stand arms?","seo_faq_1_a":"Enable the ShowArms flag - in raw NBT that\'s {ShowArms:1b}. The generator adds it automatically when you toggle arms on, and hand items only render when arms are shown.","seo_faq_2_q":"What is the Marker flag good for?","seo_faq_2_a":"Marker:1b removes the hitbox and gravity entirely, making the stand click-through and perfect for pure decoration. Note that you can no longer select it by clicking - use commands to modify or remove it.","seo_faq_3_q":"How do I remove an invisible armor stand?","seo_faq_3_a":"Run /kill @e[type=armor_stand,distance=..3] near the stand, or use a larger radius carefully on maps with many stands.","seo_faq_4_q":"Do the commands work in command blocks?","seo_faq_4_a":"Yes. Paste the generated /summon into a command block; coordinates are relative (~ ~ ~) by default so the stand spawns at the block.","seo_faq_5_q":"Which Minecraft versions are supported?","seo_faq_5_a":"The generator targets Java Edition and outputs modern component/NBT syntax; the pose NBT itself has been stable since 1.8, so poses work across almost all versions.","seo_faq_6_q":"Can armor stands hold any item?","seo_faq_6_a":"Yes - any item can go into the hand slots, which is how item showcases, floating tools and food stalls are built on maps."},"locator_color":{"title":"Locator Bar Color","subtitle":"See the exact color of your marker on the locator bar, computed from your UUID like in the game","card_description":"Find the color of any player\'s marker on the 1.21.6+ locator bar","meta_title":"Minecraft Locator Bar Color Checker - What\'s Your Color?","meta_description":"Free locator bar color checker: see the exact color of your marker in Minecraft (Java 1.21.6+), computed from your UUID with the vanilla formula.","meta_keywords":"minecraft locator bar color, locator bar, player marker color, waypoint color minecraft, uuid color, locator icon color, minecraft 1.21.6, locator bar color checker, locator bar color finder, locator bar color bedrock","player_settings":"Player","player_name":"Username or UUID","search_placeholder":"Enter a Minecraft name or paste a UUID…","search_hint":"Enter any Minecraft name or paste a UUID - with or without dashes.","no_results":"No players found - you can also paste a UUID directly.","custom_uuid":"Custom UUID","preview":"Locator bar","preview_hint":"This is the marker other players see when you are in their range.","colors_title":"Color values","ingame_color":"In-game color","ingame_hint":"As rendered on the locator bar - brightness pinned at 90%, hue and saturation kept.","raw_color":"Raw UUID color","raw_hint":"The lower 24 bits of the UUID hash, before the brightness adjustment.","reverse_title":"Color to player","reverse_pick":"Pick a color","reverse_ingame":"Appears on the bar as","reverse_pinned":"The game pins brightness at 90%, so this is how your pick actually renders.","reverse_players":"Real players with this color","reverse_empty":"No players with this color found yet.","reverse_error":"The player lookup is currently unavailable.","reverse_note":"All results are real accounts from the laby.net player database - their markers really look like this.","seo_intro":"This tool reproduces the vanilla locator bar color computation bit for bit, so you see exactly the marker color that appears in game - for your own account or any player you look up.","seo_features_title":"Features","seo_feature_1_title":"Vanilla-exact formula","seo_feature_1_text":"The same math as the game: Java\'s UUID.hashCode, the lower 24 bits as RGB and the renderer\'s 90% brightness normalization - no approximations.","seo_feature_2_title":"In-game and raw value","seo_feature_2_text":"See both the color that is actually rendered on the bar and the raw UUID color it is derived from, each with hex and RGB.","seo_feature_3_title":"Player search","seo_feature_3_text":"Works with any Minecraft name or UUID - the tool resolves the account for you.","seo_faq_title":"Frequently asked questions","seo_faq_1_q":"What is the locator bar?","seo_faq_1_a":"Since Java Edition 1.21.6 the locator bar replaces the XP bar whenever other players are nearby and shows their direction as colored markers. While you collect experience, the XP bar briefly takes its place again.","seo_faq_2_q":"Can I change my locator bar color?","seo_faq_2_a":"Not in vanilla - the color is derived from your account UUID. Servers can override it though: scoreboard team colors take priority, and the /waypoint command can assign any hex color.","seo_faq_3_q":"Does my color change when I rename?","seo_faq_3_a":"No. The color is based on your UUID, which never changes - name changes, skins and capes have no effect on it.","seo_faq_4_q":"Why does the tool show two colors?","seo_faq_4_a":"The game first derives a raw color from the lower 24 bits of your UUID hash. The renderer then keeps hue and saturation but pins the brightness at 90% before drawing the marker - dark raw colors come out brighter, bright ones slightly darker. The in-game value is what you actually see on screen.","seo_faq_5_q":"Why does a color picker show a different value?","seo_faq_5_a":"On wide-gamut displays (like MacBooks) Minecraft renders without color management: the marker looks more saturated on screen than intended, and macOS screenshots convert it to shifted sRGB values. The computed color matches the game\'s actual framebuffer - an in-game screenshot (F2) contains exactly this value.","seo_faq_6_q":"Does this work for Bedrock Edition?","seo_faq_6_a":"No, and not because the tool skips it: Bedrock assigns the locator bar color randomly every session, so there is no fixed color to look up. Only Java Edition derives the color from your account UUID, which is exactly what this tool computes."}},"sprays":{"preview":{"open":"3D preview","title":"In-game preview","play":"Play spray","playing":"Spraying"}},"unsubscribe":{"confirm_title":"Unsubscribe","confirm_description":"Do you want to stop receiving %category% messages via %channel%%emailSuffix%?","confirm_button":"Confirm unsubscribe","done_title":"You have been unsubscribed","done_description":"You will no longer receive %category% messages via %channel%.","undo":"Undo, keep me subscribed","invalid_title":"This link is not valid","invalid_description":"This unsubscribe link is invalid or has expired. You can manage all your preferences from your account.","manage_preferences":"Manage preferences","manage_all":"Sign in to manage all communication settings"}}')}]);

