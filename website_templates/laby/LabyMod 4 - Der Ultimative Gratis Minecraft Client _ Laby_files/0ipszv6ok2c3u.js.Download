 news and updates.","link_copied":"Link copied!","no_results":"No results found","no_results_hint":"Try adjusting your search or browse the categories.","not_found":"Article not found","not_found_description":"The requested FAQ article could not be found.","not_helpful":"Not helpful","search_placeholder":"Search FAQ...","twitter":"Twitter","twitter_description":"Follow us on Twitter for updates and send us a direct message.","was_helpful":"Was this article helpful?","meta_title":"LabyMod Support & FAQ - Get Help","meta_description":"Answers to the most common LabyMod questions plus direct help. Installation, accounts, cosmetics, bans and payments, all covered in one place.","streak_meta_title":"Streak Restore Request","streak_meta_description":"Request to restore your LabyMod streak. Submit a streak restore request if you lost your streak due to technical issues.","tickets_meta_title":"My Tickets","tickets_meta_description":"View and manage your support tickets","new_ticket_meta_title":"New Ticket","new_ticket_meta_description":"Create a new support ticket","ticket_detail_meta_title":"Ticket","ticket_detail_meta_description":"View your support ticket","faq_article":"FAQ Article","tickets":{"my_tickets":"My Tickets","my_tickets_subtitle":"View and manage your support tickets","new_ticket":"New Ticket","no_tickets":"No tickets yet","no_tickets_description":"Create a ticket to get help from our support team.","create_ticket":"Create Ticket","section_open":"Open","section_closed":"Closed","status_open":"Open","status_awaiting_staff":"Awaiting Staff","status_awaiting_user":"Awaiting You","status_in_progress":"In Progress","status_on_hold":"On Hold","status_resolved":"Resolved","status_closed":"Closed","reply_placeholder":"Type your reply..."},"form":{"submit":"Submit"}},"tickets":{"my_tickets":"My Tickets","create":{"title":"New Ticket","subtitle":"Describe your issue and we\'ll get back to you","category":"Category","category_placeholder":"Select a category","subcategor