","search_faq_placeholder":"Search for something...","or_contact":"or message us directly","rate":{"helpful":"Helpful?","helpful_yes":"Helpful","not_helpful":"Not helpful"},"category":{"general":"General","client":"Client","website":"Website","shop":"Shop","security":"Security","tutorial":"Tutorials"},"sidenav":{"title":"Get support","contact":"Contact"},"error":{"not_found":{"title":"Our wolf is sad - We found nothing!","description":"Our wolf has searched everywhere, but found nothing in the FAQ. Please contact the official support.","button":"Give me support!"}},"streak":{"title":"Streak Restore","description":"Get help regarding your LabyMod streak","restore_request_title":"Your streak restore requests","request_title":"Request streak restore","faq":{"symbol_description":{"question":"What does the number next to the %flame%-symbol mean?","answer":"The number next to the flame icon indicates how many days you have already been online with LabyMod and were connected to our LabyChat on a daily basis."},"continue_info":{"question":"How and when will your streak be continued?","answer":"Your streak will then continue if you start LabyMod on a daily basis and if you are connected to our LabyChat (ESC/Multiplayer -> Chat)."},"expire":{"question":"What does the %hourglass%-symbol mean?","answer":"The hourglass icon means that you will soon lose your streak, as it seems like you have not been online and/or connected to the LabyChat yet."},"potential_bug":{"question":"Your streak was discontinued despite being connected to our LabyChat every day?","answer":"Please contact our support through the form on this page."},"chat_issue":{"question":"I cannot connect to the LabyChat. What will happen to my streak?","answer":"Please contact our support. Please do NOT use the form on this page until the problem is fixed."}},"request":{"title":"Request from %requested_at%","actual_restore":"Restored to","reviewed_at":"Reviewed at","requested_by_staff":"Requested by a LabyMod staff me