."},"creation_date":{"title":"Your creation date","description":"We can request the creation date of your account. By enabling this option, we can show the creation year on your profile (this can be turned off at any time) and it\'s possible to receive one of these badges:","save_change_date":"Due to the shutdown of the name history API we\'re estimating the date of your name changes, we can correct the latest entry by requesting the exact date.","fix_name_history":"Fix name history"}},"errors":{"unknown":"An error occurred. Please try again.","invalid_credentials":"Invalid email/username or password.","invalid_2fa":"Invalid verification code. Please try again.","invalid_verification":"Invalid verification code. Please try again.","session_expired":"Your session has expired. Please sign in again.","missing_token":"Authentication token missing. Please sign in again.","user_not_found":"User not found.","account_locked":"Your account has been locked. Please contact support.","captcha_required":"Please complete the captcha verification.","captcha_failed":"Captcha verification failed. Please try again.","missing_field":"Please fill in all required fields.","password_too_short":"Password must be at least 8 characters.","email_not_found":"An error occurred. Please try again.","microsoft_failed":"Microsoft sign-in failed. Please try again.","product_not_found":"No Minecraft account found for this Microsoft account.","microsoft_retry":"Unfortunately, we could not authenticate you. Please try again later.","identifier_required":"Please enter your email or username first.","passkey_cancelled":"Passkey authentication was cancelled.","passkey_failed":"Passkey authentication failed. Please try again.","no_passkeys":"No passkeys found for this account.","invalid_challenge":"Authentication challenge expired. Please try again.","challenge_expired":"Authentication challenge expired. Please try again.","account_exists":"An account already exists with this Minecraft profile. Please sign in instead.","xbox_child_account":"This Microsoft account belongs to a minor and has to be part of a Microsoft Family.","xbox_account_missing":"This Microsoft account does not have an Xbox profile yet.","xbox_terms_not_accepted":"The Xbox terms of service have not been accepted yet.","xbox_region_unavailable":"Xbox Live is not available in the country set on this account.","xbox_adult_verification":"This Microsoft account needs an adult verification first.","xbox_banned":"This Microsoft account is banned from Xbox Live."},"error_details":{"retry":"Try again with Microsoft","xbox_child_account":{"title":"Your Microsoft account needs a family group","description":"Xbox blocks sign-ins from accounts of minors until an adult adds them to a Microsoft Family. Ask a parent or guardian to add your account, then sign in again.","help":"Set up Microsoft Family"},"xbox_account_missing":{"title":"No Xbox profile on this account","description":"Signing in with Minecraft runs through Xbox Live. Create a free Xbox profile for your Microsoft account, then come back and sign in again.","help":"Create an Xbox profile"},"xbox_terms_not_accepted":{"title":"Xbox terms not accepted yet","description":"Microsoft is still waiting for you to accept the Xbox Live terms of service. Sign in at xbox.com once, accept them, then try again here.","help":"Open xbox.com"},"xbox_region_unavailable":{"title":"Xbox Live is unavailable in this region","description":"Xbox Live does not operate in the country set on your Microsoft account, so it cannot be used to sign in. Changing the country on your account resolves this.","help":"Change your account country"},"xbox_adult_verification":{"title":"Adult verification required","description":"Xbox requires an age verification for accounts in your region before they can be used. Complete it in your Xbox account settings, then sign in again.","help":"Open Xbox settings"},"xbox_banned":{"title":"This account is banned from Xbox Live","description":"Xbox Live 